<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8"/>
  <meta name="viewport" content="width=device-width, initial-scale=1.0"/>
  <title>About | Royal Mist</title>
  <link href="https://fonts.googleapis.com/css2?family=Playfair+Display:ital,wght@0,400;0,500;0,600;0,700;1,400;1,600&family=Cormorant+Garamond:ital,wght@0,300;0,400;0,500;1,300;1,400&display=swap" rel="stylesheet"/>
  <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/css/bootstrap.min.css" rel="stylesheet"/>
  <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css"/>
  <style>
    :root {
      --gold: #c4a14d;
      --gold-light: #d4b45d;
      --gold-dim: rgba(196,161,77,0.15);
      --dark-bg: #000000;
      --card-bg: #0a0a0a;
      --font-main: 'Playfair Display', serif;
      --font-sub: 'Cormorant Garamond', serif;
    }
    * { box-sizing: border-box; margin: 0; padding: 0; }
    html { scroll-behavior: smooth; }
    body {
      background: var(--dark-bg);
      color: #fff;
      font-family: var(--font-main);
      overflow-x: hidden;
    }

    /* ── NAVBAR ── */
    .navbar {
      background: rgba(0,0,0,0.97);
      border-bottom: 1px solid #222;
      padding: 15px 0;
      position: sticky;
      top: 0;
      z-index: 1000;
    }
    .navbar-brand { color: var(--gold) !important; letter-spacing: 4px; font-weight: 700; }
    .nav-link { color: #fff !important; font-size: 12px; letter-spacing: 2px; }
    .nav-link:hover { color: var(--gold) !important; }
    .user-dropdown { position: relative; z-index: 2000; }
    .dropdown-menu-custom {
      position: absolute; top: 100%; right: 0;
      background: #0a0a0a; border: 1px solid #222;
      min-width: 160px; z-index: 3000; display: none;
      box-shadow: 0 10px 25px rgba(0,0,0,0.5);
    }
    .dropdown-menu-custom.show { display: block; }
    @media (max-width: 768px) {
      .dropdown-menu-custom { position: fixed; top: auto; right: 10px; left: auto; max-width: calc(100vw - 20px); }
    }
    .dropdown-item-custom {
      color: #fff; background: none; border: none;
      text-decoration: none; display: block;
      padding: 10px 15px; width: 100%; text-align: left;
      font-family: var(--font-main); font-size: 13px; cursor: pointer;
    }
    .dropdown-item-custom:hover { color: var(--gold); background: #111; }

    /* ── HERO ── */
    .about-hero {
      min-height: 100vh;
      display: flex;
      align-items: center;
      position: relative;
      overflow: hidden;
      background: #000;
    }
    .hero-bg-lines {
      position: absolute;
      inset: 0;
      background-image:
        repeating-linear-gradient(
          90deg,
          transparent,
          transparent 80px,
          rgba(196,161,77,0.03) 80px,
          rgba(196,161,77,0.03) 81px
        );
      pointer-events: none;
    }
    .hero-circle {
      position: absolute;
      right: -200px;
      top: 50%;
      transform: translateY(-50%);
      width: 700px;
      height: 700px;
      border-radius: 50%;
      border: 1px solid rgba(196,161,77,0.08);
      pointer-events: none;
    }
    .hero-circle::before {
      content: '';
      position: absolute;
      inset: 60px;
      border-radius: 50%;
      border: 1px solid rgba(196,161,77,0.05);
    }
    .hero-circle::after {
      content: '';
      position: absolute;
      inset: 120px;
      border-radius: 50%;
      border: 1px solid rgba(196,161,77,0.04);
    }
    .hero-content {
      position: relative;
      z-index: 2;
      padding: 100px 0;
    }
    .hero-eyebrow {
      font-size: 10px;
      letter-spacing: 6px;
      color: var(--gold);
      text-transform: uppercase;
      margin-bottom: 24px;
      display: flex;
      align-items: center;
      gap: 16px;
    }
    .hero-eyebrow::before {
      content: '';
      width: 40px;
      height: 1px;
      background: var(--gold);
    }
    .hero-title {
      font-family: var(--font-sub);
      font-size: clamp(3rem, 7vw, 6rem);
      font-weight: 300;
      line-height: 1.1;
      color: #fff;
      margin-bottom: 30px;
    }
    .hero-title em {
      font-style: italic;
      color: var(--gold);
    }
    .hero-desc {
      font-family: var(--font-sub);
      font-size: 18px;
      color: #888;
      line-height: 1.9;
      max-width: 520px;
      font-weight: 300;
      margin-bottom: 40px;
    }
    .hero-scroll {
      display: flex;
      align-items: center;
      gap: 12px;
      font-size: 10px;
      letter-spacing: 3px;
      color: #555;
      text-decoration: none;
    }
    .hero-scroll:hover { color: var(--gold); }
    .scroll-line {
      width: 40px;
      height: 1px;
      background: #333;
      transition: background 0.3s;
    }
    .hero-scroll:hover .scroll-line { background: var(--gold); }

    /* ── GOLD DIVIDER ── */
    .gold-divider {
      display: flex;
      align-items: center;
      gap: 20px;
      margin: 0 auto;
    }
    .gold-divider::before,
    .gold-divider::after {
      content: '';
      flex: 1;
      height: 1px;
      background: linear-gradient(90deg, transparent, var(--gold), transparent);
    }
    .gold-divider i { color: var(--gold); font-size: 10px; }

    /* ── SECTION COMMON ── */
    .section-wrap { padding: 100px 0; }
    .section-label {
      font-size: 10px;
      letter-spacing: 5px;
      color: var(--gold);
      text-transform: uppercase;
      margin-bottom: 16px;
    }
    .section-heading {
      font-family: var(--font-sub);
      font-size: clamp(2rem, 4vw, 3.5rem);
      font-weight: 300;
      line-height: 1.2;
      margin-bottom: 24px;
    }
    .section-heading em { font-style: italic; color: var(--gold); }
    .section-body {
      font-family: var(--font-sub);
      font-size: 17px;
      color: #888;
      line-height: 1.9;
      font-weight: 300;
    }

    /* ── STORY SECTION ── */
    .story-section { background: #030303; border-top: 1px solid #111; border-bottom: 1px solid #111; }
    .story-number {
      font-family: var(--font-sub);
      font-size: 120px;
      font-weight: 300;
      color: rgba(196,161,77,0.06);
      line-height: 1;
      position: absolute;
      top: -20px;
      left: -20px;
      pointer-events: none;
      user-select: none;
    }
    .story-card {
      position: relative;
      padding: 50px 40px;
      border: 1px solid #1a1a1a;
      background: #060606;
      height: 100%;
      transition: border-color 0.4s;
    }
    .story-card:hover { border-color: rgba(196,161,77,0.3); }
    .story-card-year {
      font-size: 10px;
      letter-spacing: 3px;
      color: var(--gold);
      margin-bottom: 16px;
    }
    .story-card-title {
      font-size: 20px;
      font-weight: 600;
      margin-bottom: 12px;
      letter-spacing: 1px;
    }
    .story-card-text {
      font-family: var(--font-sub);
      font-size: 15px;
      color: #777;
      line-height: 1.8;
      font-weight: 300;
    }

    /* ── VALUES SECTION ── */
    .values-section { background: #000; }
    .value-item {
      padding: 40px 0;
      border-bottom: 1px solid #111;
      display: flex;
      align-items: flex-start;
      gap: 30px;
      transition: padding-left 0.3s;
    }
    .value-item:hover { padding-left: 10px; }
    .value-item:last-child { border-bottom: none; }
    .value-icon {
      width: 48px;
      height: 48px;
      border: 1px solid rgba(196,161,77,0.3);
      display: flex;
      align-items: center;
      justify-content: center;
      flex-shrink: 0;
      color: var(--gold);
      font-size: 16px;
      transition: background 0.3s;
    }
    .value-item:hover .value-icon { background: var(--gold-dim); }
    .value-title {
      font-size: 16px;
      font-weight: 600;
      letter-spacing: 2px;
      margin-bottom: 8px;
    }
    .value-text {
      font-family: var(--font-sub);
      font-size: 15px;
      color: #777;
      line-height: 1.7;
      font-weight: 300;
    }

    /* ── STATS SECTION ── */
    .stats-section {
      background: #030303;
      border-top: 1px solid #111;
      border-bottom: 1px solid #111;
      padding: 80px 0;
    }
    .stat-item { text-align: center; padding: 20px; }
    .stat-number {
      font-family: var(--font-sub);
      font-size: 64px;
      font-weight: 300;
      color: var(--gold);
      line-height: 1;
      margin-bottom: 8px;
    }
    .stat-label {
      font-size: 10px;
      letter-spacing: 3px;
      color: #555;
      text-transform: uppercase;
    }
    .stat-divider {
      width: 1px;
      background: #1a1a1a;
      align-self: stretch;
    }

    /* ── PROCESS SECTION ── */
    .process-section { background: #000; }
    .process-step {
      display: flex;
      gap: 30px;
      padding: 40px 0;
      border-bottom: 1px solid #0d0d0d;
      align-items: flex-start;
    }
    .process-step:last-child { border-bottom: none; }
    .step-num {
      font-family: var(--font-sub);
      font-size: 48px;
      font-weight: 300;
      color: rgba(196,161,77,0.2);
      line-height: 1;
      flex-shrink: 0;
      width: 60px;
    }
    .step-content {}
    .step-title {
      font-size: 16px;
      font-weight: 600;
      letter-spacing: 2px;
      margin-bottom: 10px;
      color: #fff;
    }
    .step-text {
      font-family: var(--font-sub);
      font-size: 15px;
      color: #777;
      line-height: 1.8;
      font-weight: 300;
    }

    /* ── FRAGRANCE FAMILIES ── */
    .families-section {
      background: #030303;
      border-top: 1px solid #111;
      border-bottom: 1px solid #111;
    }
    .family-card {
      background: #060606;
      border: 1px solid #1a1a1a;
      padding: 32px 28px;
      height: 100%;
      transition: all 0.3s;
      position: relative;
      overflow: hidden;
    }
    .family-card::before {
      content: '';
      position: absolute;
      bottom: 0; left: 0; right: 0;
      height: 2px;
      background: var(--gold);
      transform: scaleX(0);
      transition: transform 0.3s;
    }
    .family-card:hover { border-color: rgba(196,161,77,0.25); transform: translateY(-4px); }
    .family-card:hover::before { transform: scaleX(1); }
    .family-icon {
      font-size: 28px;
      color: var(--gold);
      margin-bottom: 16px;
      opacity: 0.8;
    }
    .family-name {
      font-size: 14px;
      font-weight: 600;
      letter-spacing: 2px;
      margin-bottom: 10px;
      text-transform: uppercase;
    }
    .family-desc {
      font-family: var(--font-sub);
      font-size: 14px;
      color: #666;
      line-height: 1.7;
      font-weight: 300;
    }
    .family-notes {
      margin-top: 16px;
      display: flex;
      flex-wrap: wrap;
      gap: 6px;
    }
    .note-tag {
      font-size: 9px;
      letter-spacing: 1px;
      color: var(--gold);
      border: 1px solid rgba(196,161,77,0.2);
      padding: 3px 8px;
    }

    /* ── PROMISE SECTION ── */
    .promise-section {
      background: #000;
      padding: 120px 0;
      text-align: center;
      position: relative;
      overflow: hidden;
    }
    .promise-bg {
      position: absolute;
      inset: 0;
      background: radial-gradient(ellipse at center, rgba(196,161,77,0.04) 0%, transparent 70%);
      pointer-events: none;
    }
    .promise-quote {
      font-family: var(--font-sub);
      font-size: clamp(1.5rem, 3vw, 2.8rem);
      font-weight: 300;
      font-style: italic;
      color: #fff;
      max-width: 800px;
      margin: 0 auto 30px;
      line-height: 1.5;
    }
    .promise-quote span { color: var(--gold); }
    .promise-attr {
      font-size: 10px;
      letter-spacing: 4px;
      color: #555;
      text-transform: uppercase;
    }

    /* ── CTA SECTION ── */
    .cta-section {
      background: #030303;
      border-top: 1px solid #111;
      padding: 100px 0;
      text-align: center;
    }
    .btn-gold {
      display: inline-block;
      background: var(--gold);
      color: #000;
      font-family: var(--font-main);
      font-size: 11px;
      font-weight: 700;
      letter-spacing: 3px;
      padding: 16px 40px;
      text-decoration: none;
      transition: all 0.3s;
      border: none;
      cursor: pointer;
    }
    .btn-gold:hover {
      background: var(--gold-light);
      color: #000;
      transform: translateY(-2px);
      box-shadow: 0 8px 24px rgba(196,161,77,0.25);
    }
    .btn-outline-gold {
      display: inline-block;
      background: transparent;
      color: var(--gold);
      font-family: var(--font-main);
      font-size: 11px;
      font-weight: 600;
      letter-spacing: 3px;
      padding: 15px 40px;
      text-decoration: none;
      border: 1px solid var(--gold);
      transition: all 0.3s;
    }
    .btn-outline-gold:hover {
      background: var(--gold);
      color: #000;
    }

    /* ── FOOTER ── */
    footer { border-top: 1px solid #222; padding: 80px 0 30px; }

    /* ── ANIMATIONS ── */
    .fade-up {
      opacity: 0;
      transform: translateY(30px);
      transition: opacity 0.7s ease, transform 0.7s ease;
    }
    .fade-up.visible {
      opacity: 1;
      transform: translateY(0);
    }
    .fade-up-delay-1 { transition-delay: 0.1s; }
    .fade-up-delay-2 { transition-delay: 0.2s; }
    .fade-up-delay-3 { transition-delay: 0.3s; }
    .fade-up-delay-4 { transition-delay: 0.4s; }

    @media (max-width: 768px) {
      .hero-title { font-size: 2.8rem; }
      .story-number { font-size: 80px; }
      .stat-number { font-size: 44px; }
      .stat-divider { display: none; }
    }
  </style>
</head>
<body>

<!-- ══ NAVBAR ══════════════════════════════════════════════════ -->
<nav class="navbar navbar-expand-lg">
  <div class="container">
    <a class="navbar-brand" href="/home">
      <i class="fas fa-gem me-2" style="color:var(--gold)"></i>ROYALMIST
    </a>
    <button class="navbar-toggler border-0" type="button" data-bs-toggle="collapse" data-bs-target="#mainNav">
      <i class="fas fa-bars text-white"></i>
    </button>
    <div class="collapse navbar-collapse" id="mainNav">
      <ul class="navbar-nav mx-auto">
        <li class="nav-item"><a class="nav-link" href="/home">HOME</a></li>
        <li class="nav-item"><a class="nav-link" href="/shop">SHOP</a></li>
        <li class="nav-item"><a class="nav-link" style="color:var(--gold)!important" href="#">ABOUT</a></li>
      </ul>
      <div class="d-flex gap-3 align-items-center">
        <a href="/wishlist"><i class="fa-regular fa-heart" style="cursor:pointer;color:#fff"></i></a>
        <a href="/cart" style="position:relative;">
          <i class="fa-solid fa-bag-shopping" style="color:#fff;font-size:16px;"></i>
          <% if(typeof cartCount !== 'undefined' && cartCount > 0) { %>
            <span style="position:absolute;top:-8px;right:-8px;background:var(--gold);color:#000;font-size:9px;font-weight:700;width:17px;height:17px;border-radius:50%;display:flex;align-items:center;justify-content:center;"><%= cartCount %></span>
          <% } %>
        </a>
        <div class="user-dropdown">
          <% if(typeof user !== 'undefined' && user) { %>
            <span id="userIcon" style="cursor:pointer;color:#fff;font-size:13px;letter-spacing:1px;">
              <%= user.firstName %> <i class="fa fa-caret-down"></i>
            </span>
            <div id="dropdownMenu" class="dropdown-menu-custom">
              <a href="/account" class="dropdown-item-custom">Account</a>
              <button id="logoutBtn" class="dropdown-item-custom">Logout</button>
            </div>
          <% } else { %>
            <a href="/signin"><i class="fa fa-user" style="color:#fff"></i></a>
          <% } %>
        </div>
      </div>
    </div>
  </div>
</nav>

<!-- ══ HERO ══════════════════════════════════════════════════════ -->
<section class="about-hero">
  <div class="hero-bg-lines"></div>
  <div class="hero-circle"></div>
  <div class="container">
    <div class="hero-content">
      <div class="hero-eyebrow fade-up">Est. 2020 — Chennai, India</div>
      <h1 class="hero-title fade-up fade-up-delay-1">
        The Art of<br>
        <em>Invisible Luxury</em>
      </h1>
      <p class="hero-desc fade-up fade-up-delay-2">
        Royal Mist was born from a singular obsession — to bottle emotions, 
        memories, and moments into fragrances that linger long after you leave the room.
      </p>
      <a href="#story" class="hero-scroll fade-up fade-up-delay-3">
        <span class="scroll-line"></span>
        DISCOVER OUR STORY
      </a>
    </div>
  </div>
</section>

<!-- ══ STORY ══════════════════════════════════════════════════════ -->
<section class="section-wrap story-section" id="story">
  <div class="container">
    <div class="row g-5 align-items-center mb-5">
      <div class="col-lg-5 fade-up">
        <div class="section-label">Our Story</div>
        <h2 class="section-heading">
          Born from a <em>Passion</em><br>for Perfumery
        </h2>
      </div>
      <div class="col-lg-7 fade-up fade-up-delay-1">
        <p class="section-body mb-4">
          Royal Mist began as a small atelier in Chennai, where our founder discovered 
          the transformative power of fragrance during travels across the Middle East and Europe. 
          Captivated by how a single scent could transport the mind to distant places and forgotten memories, 
          the journey to create India's finest luxury fragrance house began.
        </p>
        <p class="section-body">
          Today, we craft every bottle with the same reverence — sourcing the finest raw materials 
          from Grasse in France, the rose valleys of Bulgaria, and the oud forests of Southeast Asia, 
          blending them into compositions that are uniquely, unmistakably Royal Mist.
        </p>
      </div>
    </div>

    <div class="row g-4 mt-2">
      <div class="col-md-4 fade-up">
        <div class="story-card">
          <div class="story-number">01</div>
          <div class="story-card-year">2020 — THE BEGINNING</div>
          <div class="story-card-title">A Dream in a Bottle</div>
          <p class="story-card-text">
            Our founder's kitchen table became the first laboratory. Hundreds of blends later, 
            the first Royal Mist fragrance — Noir Saffron — was born.
          </p>
        </div>
      </div>
      <div class="col-md-4 fade-up fade-up-delay-1">
        <div class="story-card">
          <div class="story-number">02</div>
          <div class="story-card-year">2022 — RECOGNITION</div>
          <div class="story-card-title">The World Takes Notice</div>
          <p class="story-card-text">
            Featured in leading lifestyle publications and beloved by discerning collectors, 
            Royal Mist grew from a local secret to a nationally recognised name.
          </p>
        </div>
      </div>
      <div class="col-md-4 fade-up fade-up-delay-2">
        <div class="story-card">
          <div class="story-number">03</div>
          <div class="story-card-year">2026 — TODAY</div>
<div class="story-card-title">Luxury, Democratised</div>
          <p class="story-card-text">
            We brought world-class perfumery online — making premium, authentic fragrances 
            accessible to connoisseurs across every corner of India.
          </p>
        </div>
      </div>
    </div>
  </div>
</section>

<!-- ══ STATS ══════════════════════════════════════════════════════ -->
<section class="stats-section">
  <div class="container">
    <div class="d-flex justify-content-center align-items-stretch flex-wrap gap-0">
      <div class="stat-item fade-up" style="flex:1;min-width:160px;">
        <div class="stat-number">50+</div>
        <div class="stat-label">Unique Fragrances</div>
      </div>
      <div class="stat-divider fade-up"></div>
      <div class="stat-item fade-up fade-up-delay-1" style="flex:1;min-width:160px;">
        <div class="stat-number">12K+</div>
        <div class="stat-label">Happy Customers</div>
      </div>
      <div class="stat-divider fade-up fade-up-delay-1"></div>
      <div class="stat-item fade-up fade-up-delay-2" style="flex:1;min-width:160px;">
        <div class="stat-number">8</div>
        <div class="stat-label">Fragrance Families</div>
      </div>
      <div class="stat-divider fade-up fade-up-delay-2"></div>
      <div class="stat-item fade-up fade-up-delay-3" style="flex:1;min-width:160px;">
        <div class="stat-number">100%</div>
        <div class="stat-label">Authentic Ingredients</div>
      </div>
    </div>
  </div>
</section>

<!-- ══ VALUES ══════════════════════════════════════════════════════ -->
<section class="section-wrap values-section">
  <div class="container">
    <div class="row g-5">
      <div class="col-lg-4 fade-up">
        <div class="section-label">What We Stand For</div>
        <h2 class="section-heading">
          Our Core <em>Values</em>
        </h2>
        <p class="section-body">
          Every decision we make — from sourcing to bottling — is guided by principles 
          that have defined Royal Mist since day one.
        </p>
      </div>
      <div class="col-lg-8 fade-up fade-up-delay-1">
        <div class="value-item">
          <div class="value-icon"><i class="fas fa-seedling"></i></div>
          <div>
            <div class="value-title">AUTHENTIC SOURCING</div>
            <p class="value-text">
              We source every raw material directly from certified farms and distilleries worldwide. 
              No shortcuts. No synthetic substitutes for natural ingredients. What you smell is exactly what nature intended.
            </p>
          </div>
        </div>
        <div class="value-item">
          <div class="value-icon"><i class="fas fa-flask"></i></div>
          <div>
            <div class="value-title">ARTISAN CRAFTSMANSHIP</div>
            <p class="value-text">
              Each fragrance is developed over months of meticulous blending by our master perfumers. 
              We never rush art. Every bottle represents hundreds of hours of creative refinement.
            </p>
          </div>
        </div>
        <div class="value-item">
