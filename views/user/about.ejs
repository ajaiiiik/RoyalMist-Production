        </div>
        <p style="font-family:var(--font-sub);color:#888;font-size:14px;margin-bottom:24px;line-height:1.6;">
            Have a question? Send us a message and we'll get back to you soon.
        </p>

        <form id="contactForm">
            <div style="margin-bottom:16px;">
                <label style="display:block;font-size:10px;letter-spacing:2px;color:var(--gold);margin-bottom:8px;text-transform:uppercase;">Your Name</label>
                <input type="text" id="contactName" placeholder="Enter your name" style="width:100%;padding:12px 14px;background:#000;border:1px solid #333;color:#fff;font-family:var(--font-main);font-size:14px;outline:none;">
                <div id="contactNameErr" style="color:#e05252;font-size:11px;margin-top:5px;display:none;"></div>
            </div>

            <div style="margin-bottom:16px;">
                <label style="display:block;font-size:10px;letter-spacing:2px;color:var(--gold);margin-bottom:8px;text-transform:uppercase;">Your Email</label>
                <input type="email" id="contactEmail" placeholder="you@example.com" style="width:100%;padding:12px 14px;background:#000;border:1px solid #333;color:#fff;font-family:var(--font-main);font-size:14px;outline:none;">
                <div id="contactEmailErr" style="color:#e05252;font-size:11px;margin-top:5px;display:none;"></div>
            </div>

            <div style="margin-bottom:24px;">
                <label style="display:block;font-size:10px;letter-spacing:2px;color:var(--gold);margin-bottom:8px;text-transform:uppercase;">Message</label>
                <textarea id="contactMessage" placeholder="Type your message here..." rows="5" style="width:100%;padding:12px 14px;background:#000;border:1px solid #333;color:#fff;font-family:var(--font-main);font-size:14px;outline:none;resize:vertical;"></textarea>
                <div id="contactMessageErr" style="color:#e05252;font-size:11px;margin-top:5px;display:none;"></div>
            </div>

            <div style="display:flex;gap:12px;">
                <button type="submit" id="contactSubmitBtn" class="btn-gold" style="flex:1;text-align:center;">SEND MESSAGE</button>
                <button type="button" onclick="closeContactModal()" class="btn-outline-gold" style="flex:1;text-align:center;cursor:pointer;">CANCEL</button>
            </div>
        </form>
    </div>
</div>

