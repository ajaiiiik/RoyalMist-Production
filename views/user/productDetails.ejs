  <div class="toast-msg" id="toastMsg" style="position:fixed;top:30px;right:30px;background:#0a0a0a;border:1px solid var(--gold);color:var(--gold);font-size:12px;letter-spacing:1px;padding:12px 20px;z-index:9999;display:none;font-family:var(--font-main);"></div>

<!-- ── CONFIRM MODAL (for delete review) ── -->
<div class="confirm-overlay" id="confirmOverlay" style="position:fixed;inset:0;background:rgba(0,0,0,0.88);display:flex;align-items:center;justify-content:center;z-index:9998;opacity:0;pointer-events:none;transition:opacity 0.25s ease;">
  <div class="confirm-box" style="background:#0a0a0a;border:1px solid #2a2a2a;padding:36px 32px;max-width:360px;width:90%;text-align:center;">
    <div class="confirm-icon" style="width:52px;height:52px;border:1px solid #c0392b;border-radius:50%;display:flex;align-items:center;justify-content:center;margin:0 auto 16px;color:#c0392b;font-size:18px;">
      <i class="fas fa-trash-alt"></i>
    </div>
    <div class="confirm-title" style="font-size:14px;letter-spacing:3px;color:#fff;font-weight:600;margin-bottom:8px;">DELETE REVIEW?</div>
    <div class="confirm-sub" style="font-size:11px;color:#555;letter-spacing:1px;line-height:1.7;margin-bottom:22px;">Are you sure you want to delete your review? This action cannot be undone.</div>
    <div class="confirm-actions" style="display:flex;gap:10px;">
      <button onclick="closeConfirmModal()" style="flex:1;background:transparent;border:1px solid #2a2a2a;color:#666;font-family:var(--font-main);font-size:11px;letter-spacing:2px;padding:14px;cursor:pointer;transition:0.2s;">CANCEL</button>
      <button id="confirmDeleteReviewBtn" style="flex:1;background:#c0392b;border:none;color:#fff;font-family:var(--font-main);font-size:11px;letter-spacing:2px;font-weight:700;padding:14px;cursor:pointer;transition:0.2s;">YES, DELETE</button>
    </div>
  </div>
</div>

  <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/js/bootstrap.bundle.min.js"></script>
  <script>
  // ── Selected state ───────────────────────────────────────────────
  let selectedPrice = <%= product.volumes && product.volumes[0] ? product.volumes[0].price : 0 %>;
  let selectedSize  = "<%= product.volumes && product.volumes[0] ? product.volumes[0].size : '' %>";
  const productId   = "<%= product._id %>";

  // ── Image zoom (mouse position based) ───────────────────────────
  const mainWrap = document.getElementById("mainImgWrap");
  const mainImg  = document.getElementById("mainImg");
  if (mainWrap && mainImg) {
    mainWrap.addEventListener("mousemove", (e) => {
      const rect = mainWrap.getBoundingClientRect();
      const x = ((e.clientX - rect.left) / rect.width)  * 100;
      const y = ((e.clientY - rect.top)  / rect.height) * 100;
      mainImg.style.transformOrigin = `${x}% ${y}%`;
    });
    mainWrap.addEventListener("mouseleave", () => {
      mainImg.style.transformOrigin = "center center";
    });
  }

  // ── Thumbnail switch ─────────────────────────────────────────────
  function changeImage(src, el) {
    mainImg.src = src;
    document.querySelectorAll(".thumb").forEach(t => t.classList.remove("active"));
    el.classList.add("active");
  }

  // ── Volume select ────────────────────────────────────────────────
  const hasOffer     = <%= product.hasOffer ? 'true' : 'false' %>;
  const offerDiscount = <%= product.hasOffer ? (product.originalBasePrice - product.discountedBasePrice) : 0 %>;

  function selectVolume(btn, price, size, stock) {
    document.querySelectorAll(".vol-btn").forEach(b => b.classList.remove("selected"));
    btn.classList.add("selected");
    selectedSize = size;

    // Stock badge update
    const badge = document.getElementById("stockBadge");
    if(stock === 0) {
      badge.className = "stock-badge out-stock";
      badge.innerHTML = '<span class="stock-dot red"></span> OUT OF STOCK';
      const cartBtn = document.getElementById("addToCartBtn");
      if(cartBtn) cartBtn.disabled = true;
    } else if(stock <= 5) {
      badge.className = "stock-badge low-stock";
      badge.innerHTML = '<span class="stock-dot yellow"></span> ONLY ' + stock + ' LEFT';
      const cartBtn = document.getElementById("addToCartBtn");
      if(cartBtn) cartBtn.disabled = false;
    } else {
      badge.className = "stock-badge in-stock";
    badge.innerHTML = '<span class="stock-dot green"></span> IN STOCK (' + stock + ' units)';
      const cartBtn = document.getElementById("addToCartBtn");
      if(cartBtn) cartBtn.disabled = false;
    }
  // Stock table update
    const tableCell = document.getElementById("stockTableCell");
    if(tableCell) tableCell.textContent = stock + " units";
    // Price update
    if(hasOffer) {
      const discounted = Math.max(0, price - offerDiscount);
      selectedPrice = discounted;
      document.getElementById("priceDisplay").innerHTML =
        "₹" + discounted.toLocaleString("en-IN") +
        ' <span style="font-size:16px;color:#555;text-decoration:line-through;margin-left:8px;">₹' +
        price.toLocaleString("en-IN") + '</span>';
    } else {
      selectedPrice = price;
      document.getElementById("priceDisplay").textContent =
        "₹" + price.toLocaleString("en-IN");
    }
  }

  // ── Navbar dropdown ──────────────────────────────────────────────
  const userIcon     = document.getElementById("userIcon");
  const dropdownMenu = document.getElementById("dropdownMenu");
  if (userIcon && dropdownMenu) {
    userIcon.addEventListener("click", e => {
      e.stopPropagation();
      dropdownMenu.classList.toggle("show");
    });
    window.addEventListener("click", () => dropdownMenu.classList.remove("show"));
  }

  // ── Logout ───────────────────────────────────────────────────────
  const logoutBtn = document.getElementById("logoutBtn");
  if (logoutBtn) {
    logoutBtn.addEventListener("click", async () => {
      await fetch("/logout", { method: "POST" });
      window.location.href = "/signin";
    });
  }

  // ── Add to Cart ──────────────────────────────────────────────────
  let selectedQty = 1;

  function changeQty(delta) {
    selectedQty = Math.min(5, Math.max(1, selectedQty + delta));
    document.getElementById("qtyDisplay").textContent = selectedQty;
  }

  async function addToCart() {
    const btn = document.getElementById("addToCartBtn");
    btn.disabled = true;
    btn.innerHTML = '<i class="fas fa-spinner fa-spin me-2"></i>ADDING...';

    try {
      const res = await fetch("/cart/add", {
        method: "POST",
        headers: { "Content-Type": "application/json" },
        body: JSON.stringify({
          productId,
          quantity: selectedQty,
          size: selectedSize,
          price: selectedPrice
        })
      });
      const data = await res.json();
      if (data.success) {
        btn.innerHTML = '<i class="fas fa-check me-2"></i>ADDED TO CART!';
        btn.style.background = "#2d6a2d";
        btn.style.color = "#fff";
        setTimeout(() => {
          btn.disabled = false;
          btn.innerHTML = '<i class="fas fa-shopping-bag me-2"></i>ADD TO CART';
          btn.style.background = "";
          btn.style.color = "";
        }, 2000);
           } else {
        showToast(data.message || "Failed to add to cart", true);
        btn.disabled = false;
        btn.innerHTML = '<i class="fas fa-shopping-bag me-2"></i>ADD TO CART';
      }
    } catch (err) {
      showToast("Something went wrong", true);
      btn.disabled = false;
      btn.innerHTML = '<i class="fas fa-shopping-bag me-2"></i>ADD TO CART';
    }
  }

  // ── Add to Wishlist ──────────────────────────────────────────────
  async function addToWishlist() {
    try {
      const res  = await fetch("/wishlist/add", {
        method: "POST",
        headers: { "Content-Type": "application/json" },
        body: JSON.stringify({ productId })
      });
      const data = await res.json();
      const btn  = document.querySelector(".btn-wishlist");

      if (data.success) {
        btn.innerHTML     = '<i class="fas fa-heart me-2" style="color:var(--gold)"></i>ADDED TO WISHLIST';
        btn.style.borderColor = "var(--gold)";
        btn.style.color       = "var(--gold)";
      } else {
        // Already in wishlist or any error
        btn.innerHTML     = '<i class="fas fa-heart me-2" style="color:var(--gold)"></i>ALREADY IN WISHLIST';
        btn.style.borderColor = "var(--gold)";
        btn.style.color       = "var(--gold)";
        btn.disabled          = true;
      }
    } catch (err) {
      console.error(err);
    }
  }
  // ── Star selector ────────────────────────────────────────────────
  function selectStar(val) {
    document.getElementById("selectedRating").value = val;
    document.querySelectorAll(".review-star").forEach((star, i) => {
      star.className = i < val ? "fas fa-star review-star" : "far fa-star review-star";
      star.style.color = i < val ? "var(--gold)" : "#333";
    });
  }

  // Hover effect
  document.querySelectorAll(".review-star").forEach((star, i) => {
    star.addEventListener("mouseenter", () => {
      document.querySelectorAll(".review-star").forEach((s, j) => {
        s.style.color = j <= i ? "var(--gold)" : "#333";
      });
    });
    star.addEventListener("mouseleave", () => {
      const selected = parseInt(document.getElementById("selectedRating").value) || 0;
      document.querySelectorAll(".review-star").forEach((s, j) => {
        s.style.color = j < selected ? "var(--gold)" : "#333";
      });
    });
  });

  // Char count
  const commentEl = document.getElementById("reviewComment");
  if (commentEl) {
    commentEl.addEventListener("input", () => {
      document.getElementById("charCount").textContent = commentEl.value.length;
    });
  }

  // ── Submit review ────────────────────────────────────────────────
  async function submitReview() {
    const rating  = parseInt(document.getElementById("selectedRating").value);
    const comment = document.getElementById("reviewComment")?.value?.trim();
    const msgEl   = document.getElementById("reviewMsg");
    const btn     = document.getElementById("submitReviewBtn");

    if (!rating || rating < 1) {
      showMsg("Please select a star rating", true);
      return;
    }
    if (!comment || comment.length < 5) {
      showMsg("Review must be at least 5 characters", true);
      return;
    }

    btn.disabled    = true;
    btn.textContent = "SUBMITTING...";

    try {
      const res  = await fetch(`/shop/${productId}/review`, {
        method:  "POST",
        headers: { "Content-Type": "application/json" },
        body:    JSON.stringify({ rating, comment }),
      });
      const data = await res.json();

      if (data.success) {
        // Add review to list immediately
        const listEl = document.getElementById("reviewsList");
        const noMsg  = listEl.querySelector("div[style*='text-align:center']");
        if (noMsg) noMsg.remove();

        const newReview = document.createElement("div");
        newReview.className = "review-item";
        newReview.style = "padding:20px 0;border-bottom:1px solid #0f0f0f;";
        newReview.innerHTML = `
          <div style="display:flex;justify-content:space-between;align-items:flex-start;margin-bottom:8px;">
            <div>
              <div style="margin-bottom:4px;">
                ${'<i class="fas fa-star" style="color:var(--gold);font-size:12px;"></i>'.repeat(data.review.rating)}
                ${'<i class="fas fa-star" style="color:#222;font-size:12px;"></i>'.repeat(5 - data.review.rating)}
              </div>
              <div style="font-size:13px;font-weight:500;color:#ddd;">${data.review.userName}</div>
            </div>
            <div style="font-size:10px;color:#444;letter-spacing:1px;">${data.review.createdAt}</div>
          </div>
          <p style="color:#777;font-size:13px;line-height:1.7;margin:0;">"${data.review.comment}"</p>
        `;
        listEl.prepend(newReview);

        // Reload page to show "Your Review" section
        setTimeout(() => location.reload(), 1000);
      } else {
        showMsg(data.message, true);
        btn.disabled    = false;
        btn.textContent = "SUBMIT REVIEW";
      }
    } catch (err) {
      showMsg("Something went wrong", true);
      btn.disabled    = false;
      btn.textContent = "SUBMIT REVIEW";
    }
  }

   // ── Delete review ────────────────────────────────────────────────
  function deleteReview() {
    document.getElementById("confirmOverlay").style.opacity = "1";
    document.getElementById("confirmOverlay").style.pointerEvents = "all";
  }

  function closeConfirmModal() {
    document.getElementById("confirmOverlay").style.opacity = "0";
    document.getElementById("confirmOverlay").style.pointerEvents = "none";
  }

  document.getElementById("confirmDeleteReviewBtn").addEventListener("click", async () => {
    closeConfirmModal();
    try {
      const res  = await fetch(`/shop/${productId}/review`, { method: "DELETE" });
      const data = await res.json();
      if (data.success) {
        showToast("Review deleted successfully");
        setTimeout(() => location.reload(), 1000);
      } else {
        showToast(data.message, true);
      }
    } catch (err) {
      showToast("Something went wrong", true);
    }
  });

  document.getElementById("confirmOverlay").addEventListener("click", function(e) {
    if (e.target === this) closeConfirmModal();
  });

  function showMsg(msg, isError) {
    const el = document.getElementById("reviewMsg");
    if (!el) return;
    el.textContent   = msg;
    el.style.color   = isError ? "#c0392b" : "#5cb85c";
    el.style.display = "block";
    setTimeout(() => { el.style.display = "none"; }, 3000);
  }

  function showToast(msg, isError = false) {
    const t = document.getElementById("toastMsg");
    t.textContent = msg;
    t.style.borderColor = isError ? "#c0392b" : "var(--gold)";
    t.style.color = isError ? "#c0392b" : "var(--gold)";
    t.style.display = "block";
    setTimeout(() => t.style.display = "none", 3000);
  }



  </script>
  <% } %>
  </body>
  </html>
