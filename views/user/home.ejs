<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Royal Mist | Luxury Perfume Store</title>
    
    <link href="https://fonts.googleapis.com/css2?family=Playfair+Display:wght@400;500;600;700&display=swap" rel="stylesheet">
    
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/css/bootstrap.min.css" rel="stylesheet">
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css">

    <style>
        :root {
            --gold: #c4a14d;
            --dark-bg: #000000;
            --card-bg: #0a0a0a;
            --font-main: 'Playfair Display', serif;
        }

        * { box-sizing: border-box; }

        body {
            background-color: var(--dark-bg);
            color: #ffffff;
            font-family: var(--font-main);
            margin: 0;
            padding: 0;
            overflow-x: hidden;
             overflow-y: visible !important;
        }

        /* --- NAVBAR --- */
        .navbar {
            background: rgba(0,0,0,0.95);
            border-bottom: 1px solid #222;
            padding: 15px 0;
             overflow: visible !important;
        }
        .navbar-brand {
            color: var(--gold) !important;
            letter-spacing: 4px;
            font-weight: 700;
            font-family: var(--font-main);
        }
        .nav-link {
            color: #fff !important;
            font-size: 12px;
            letter-spacing: 2px;
            font-family: var(--font-main);
        }
        .search-container {
            position: relative;
            margin-right: 20px;
        }
        .search-input {
            background: transparent;
            border: none;
            border-bottom: 1px solid #444;
            color: white;
            font-size: 13px;
            padding: 5px 25px 5px 5px;
            width: 150px;
            transition: 0.3s;
            font-family: var(--font-main);
        }
        .search-input:focus {
            outline: none;
            border-color: var(--gold);
            width: 200px;
        }
        .search-icon {
            position: absolute;
            right: 5px;
            top: 50%;
            transform: translateY(-50%);
            font-size: 12px;
            color: #777;
        }

        
        .hero {
            height: 90vh;
            background: linear-gradient(rgba(0,0,0,0.3), rgba(0,0,0,0.3)), 
                       url('/images/homeimage.png');
            background-size: cover;
            background-position: center;
            display: flex;
            align-items: center;
            justify-content: center;
            text-align: center;
        }
        .hero-content h1 {
            font-size: clamp(2.5rem, 5vw, 4.5rem);
            margin-bottom: 20px;
        }
        .hero-content p {
           font-family: var(--font-main);
            color: #ccc;
            max-width: 600px;
            margin: 0 auto 30px;
        }
        .gold-text { color: var(--gold); }
        .btn-gold {
            background-color: var(--gold);
            color: #000;
            border-radius: 0;
            padding: 12px 35px;
            font-weight: 600;
            letter-spacing: 1px;
            border: none;
            transition: 0.3s;
            font-family: var(--font-main);
        }
        .btn-gold:hover {
    background-color: #b38f4d;
    transform: translateY(-2px);
    box-shadow: 0 8px 20px rgba(196,161,77,0.3);
}

        /* --- FEATURE CARDS --- */
        .feature-box {
            position: relative;
            overflow: hidden;
            height: 400px;
        }
        .feature-box img {
            width: 100%;
            height: 100%;
            object-fit: cover;
            filter: brightness(0.6);
            transition: 0.5s;
        }
        .feature-box:hover img { transform: scale(1.05); }
        .feature-text {
            position: absolute;
            bottom: 30px;
            left: 30px;
            font-size: 24px;
        }

        /* --- PRODUCT CARDS --- */
        .product-card {
            background: var(--card-bg);
            border: 1px solid #1a1a1a;
            padding: 15px;
            transition: 0.3s;
            height: 100%;
            display: flex;
            flex-direction: column;
             justify-content: space-between;
        }
        .product-card:hover { border-color: var(--gold); }
        .img-wrapper {
            position: relative;
            margin-bottom: 15px;
            flex-shrink: 0;
        }
        .offer-tag {
            position: absolute;
            top: 10px;
            left: 10px;
            background: var(--gold);
            color: #000;
            font-size: 10px;
            padding: 2px 8px;
            font-weight: bold;
            font-family: var(--font-main);
            z-index: 1;
        }
        .product-body {
            display: flex;
            flex-direction: column;
            flex: 1;
        }
        .product-info-row {
            display: flex;
            justify-content: space-between;
            align-items: flex-start;
            margin-bottom: 10px;
        }
        .product-name {
             font-size: 18px; 
             margin: 0;
            font-weight: 500; }
        .category-label { font-size: 11px; color: #777; letter-spacing: 1px; display: block; font-family: var(--font-main); }
        .rating-stars { color: var(--gold); font-size: 10px; margin-bottom: 5px; }
        .fragrance-type { font-size: 11px; color: var(--gold); text-transform: uppercase; font-family: var(--font-main); }
        
        .price-row {
            display: flex;
            justify-content: space-between;
            align-items: center;
            margin-top: auto;
            padding-top: 15px;
        }
        .price { font-size: 18px; font-weight: 600; }
        .ml-text { font-size: 12px; color: #555; font-family: var(--font-main); }

        .view-btn {
            width: 100%;
            background: transparent;
            border: 1px solid #333;
            color: #fff;
            padding: 10px;
            font-size: 12px;
            margin-top: 15px;
            letter-spacing: 2px;
            transition: 0.3s;
            cursor: pointer;
           font-family: var(--font-main);
        }
        .view-btn:hover { 
            border-color: var(--gold);
             color: var(--gold);
             background: rgba(196,161,77,0.05);
             }
        footer {
            border-top: 1px solid #222;
            padding: 80px 0 30px;
           font-family: var(--font-main);
        }
        .footer-logo {
            font-family: var(--font-main);
            color: var(--gold);
            font-size: 24px;
            margin-bottom: 20px;
            letter-spacing: 4px;
            font-weight: 700;
            display: block;
        }
        .footer-head { color: #fff; font-size: 14px; letter-spacing: 1px; margin-bottom: 20px; font-weight: 600; }
        .footer-link { color: #777; text-decoration: none; font-size: 13px; display: block; margin-bottom: 10px; transition: 0.2s; }
        .footer-link:hover { color: var(--gold); }
        .social-icons i { color: #fff; margin-right: 20px; font-size: 18px; cursor: pointer; transition: 0.2s; }
        .social-icons i:hover { color: var(--gold); }
        .footer-bottom {
            border-top: 1px solid #1a1a1a;
            margin-top: 50px;
            padding-top: 25px;
            text-align: center;
        }
        /* USER DROPDOWN CLICK VERSION */
.user-dropdown {
    position: relative;
}

.user-icon {
   cursor: pointer;
    color: #fff;          
    background: none;     
    border: none;        
    padding: 0;           
    font-family: var(--font-main);
    display: flex;
    align-items: center;
    gap: 5px;
}

.user-icon:hover {
    background:none;
    color: #fff
    
}

.user-icon .caret {
    cursor: pointer;
    display: flex;
    align-items: center;
}

.username-text {
    cursor: default;
}

/* Arrow only: pointer hand */
.caret {
    /* cursor: pointer; */
    display: inline-flex;
    align-items: center;
}

/* ITEMS */
.dropdown-item-custom {
    color: #fff;           /* white default */
    background: none;
    border: none;
    text-decoration: none;
    display: block;
    padding: 10px 15px;
    width: 100%;
    text-align: left;
    font-family: var(--font-main);
}

.dropdown-item-custom:hover {
    color: var(--gold);
     background: #111;
}



.user-dropdown {
    position: relative;
    z-index: 2000;
    display: flex;
    align-items: center;
    height: 100%;
}

.dropdown-menu-custom {
    position: absolute;   /* Relative to parent */
    top: 100%;
    right: 0;
    background: #0a0a0a;  /* Dark background */
    border: none;
    min-width: 160px;
    z-index: 3000;
    box-shadow: 0 10px 25px rgba(0,0,0,0.5);
    display: none;
    opacity: 0;
    transform: translateY(10px);
    transition: all 0.25s ease-in-out;
    visibility: hidden;
    pointer-events: none;

    display: none;
    opacity: 0;
    transform: translateY(10px);
   transition: all 0.25s ease-in-out;
   visibility: hidden;
    pointer-events: none;
}

.dropdown-menu-custom.show {
    display: block;
    opacity: 1;
    transform: translateY(0);
    visibility: visible;   
    pointer-events: auto;  
}

        @media (max-width: 768px) {
            .hero-content h1 { font-size: 2.5rem; }
            .search-container { display: none; }
            .col-6 { padding: 8px; }
        }
        @media (max-width: 991px) {
    .navbar-collapse {
        max-height: none !important;
        overflow: visible !important;
    }
}


@media (max-width: 768px) {
    .dropdown-menu-custom {
        right: 10px;
        left: auto;
    }
}

    </style>
</head>
<body>

    <!-- NAVBAR -->
    <nav class="navbar navbar-expand-lg sticky-top">
        <div class="container">
            <a class="navbar-brand d-flex align-items-center" href="#">  <i class="fas fa-gem gold-text me-2"></i>ROYALMIST</a>
            
            <button class="navbar-toggler border-0" type="button" data-bs-toggle="collapse" data-bs-target="#mainNav">
                <i class="fas fa-bars text-white"></i>
            </button>

            <div class="collapse navbar-collapse" id="mainNav">
                <ul class="navbar-nav mx-auto">
                    <li class="nav-item"><a class="nav-link active-link" href="/home">HOME</a></li>
                    <li class="nav-item"><a class="nav-link" href="/shop">SHOP</a></li>
                    <li class="nav-item"><a class="nav-link" href="/about">ABOUT</a></li>
                </ul>

                <div class="d-flex align-items-center">
                   <div class="search-container">
    <form action="/shop" method="GET" style="display:flex;align-items:center;">
        <input type="text" name="search" class="search-input" placeholder="SEARCH..." autocomplete="off"/>
        <button type="submit" style="background:none;border:none;padding:0;cursor:pointer;position:absolute;right:5px;top:50%;transform:translateY(-50%);">
            <i class="fas fa-search search-icon" style="position:static;transform:none;"></i>
        </button>
    </form>
</div>
                    <div class="d-flex gap-3 align-items-center">
                       <a href="/wishlist"><i class="fa-regular fa-heart" style="color:#fff;"></i></a>
<a href="/cart" style="position:relative;">
  <i class="fa-solid fa-bag-shopping" style="color:#fff;font-size:16px;"></i>
  <% if(typeof cartCount !== 'undefined' && cartCount > 0) { %>
    <span style="position:absolute;top:-8px;right:-8px;background:var(--gold);color:#000;font-size:9px;font-weight:700;width:17px;height:17px;border-radius:50%;display:flex;align-items:center;justify-content:center;"><%= cartCount %></span>
  <% } %>
</a>

  <div class="user-dropdown">
  <% if(user) { %>
    <div class="dropdown">
      <span id="userIcon" class="dropbtn">
        <%= user.firstName %> <i class="fa fa-caret-down"></i>
      </span>
      <div id="dropdownMenu" class="dropdown-menu-custom">
        <a href="/account" class="dropdown-item-custom">Account</a>
       <button type="button" id="logoutBtn" class="dropdown-item-custom">Logout</button>
      </div>
    </div>
  <% } else { %>
    <a href="/signin"><i class="fa fa-user"></i></a>
  <% } %>
</div>

</div>
                    </div>
                </div>
            </div>
        </div>
    </nav>

    <!-- HERO -->
    <section class="hero">
        <div class="container hero-content">
            <h1>Discover Your <br> <span class="gold-text">Signature Scent</span></h1>
            <p>Crafted in Grasse, bottled for eternity. Experience the world's most luxurious fragrances curated just for you.</p>
           <a href="/shop" class="btn btn-gold">EXPLORE COLLECTION</a>
        </div>
    </section>

    <!-- FEATURE BOXES -->
    <section class="py-5 container">
        <div class="row g-4">
            <div class="col-md-6">
                <div class="feature-box">
                    <img src="https://images.unsplash.com/photo-1594035910387-fea47794261f?q=80&w=800" alt="Distillation">
                    <div class="feature-text">The Art of Distillation</div>
                </div>
            </div>
            <div class="col-md-6">
                <div class="feature-box">
                    <img src="https://images.unsplash.com/photo-1541643600914-78b084683601?q=80&w=800" alt="Essence">
                    <div class="feature-text">Nature's Finest Essence</div>
                </div>
            </div>
        </div>
    </section>

    <!-- PRODUCTS — 4 CARDS -->
   <!-- PRODUCTS — 4 CARDS -->
<section class="container py-5">
  <div class="d-flex justify-content-between align-items-end mb-5">
    <div>
      <div style="width:50px;height:2px;background:var(--gold);margin-bottom:10px;"></div>
      <h2 class="h3 m-0" style="letter-spacing:2px;">POPULAR PERFUMES</h2>
    </div>
    <a href="/shop" class="text-secondary small text-decoration-none" 
       style="letter-spacing:2px;">VIEW ALL</a>
  </div>

  <div class="row g-4">
    <% if(products.length === 0) { %>
      <p class="text-center text-secondary">No products available</p>
    <% } %>

    <% products.forEach(product => { %>
      <% const basePrice = product.volumes?.[0]?.price || 0; %>
      <% const baseSize  = product.volumes?.[0]?.size  || ''; %>
    <%
  const isOut = !product.volumes || product.volumes.length === 0 || 
    product.volumes.every(v => v.stock === 0);
%>

      <div class="col-6 col-md-3">

        <!-- ★ KEY FIX: d-flex flex-column h-100 -->
        <div class="product-card d-flex flex-column h-100">

          <div class="img-wrapper">
            <% if(isOut) { %>
              <div class="offer-tag" 
                style="background:#333;color:#999;">OUT OF STOCK</div>
            <% } %>
            <img
              src="<%= product.images?.[0] || '/images/placeholder.jpg' %>"
              class="w-100"
              style="aspect-ratio:1/1.2;object-fit:cover;<%= isOut ? 'filter:grayscale(60%)brightness(0.6)' : '' %>"
              loading="lazy"
              alt="<%= product.name %>"
            />
          </div>

          <!-- ★ flex-grow-1 makes body fill remaining space -->
          <div class="product-body flex-grow-1 d-flex flex-column">

            <div class="product-info-row">
              <div class="text-start">
                <span class="category-label">
                  <%= product.category ? product.category.name : '' %>
                </span>
                <h3 class="product-name"><%= product.name %></h3>
              </div>
              <div class="text-end">
                <span class="fragrance-type"><%= product.fragranceType %></span>
              </div>
            </div>

            <!-- ★ mt-auto pushes price+button to bottom always -->
            <div class="mt-auto">
            <div class="price-row">
  <div>
    <div style="font-size:10px;color:#555;letter-spacing:1px;">FROM</div>
    <div class="price">₹<%= basePrice.toLocaleString('en-IN') %></div>
  </div>
  <% if(product.volumes && product.volumes.length > 1) { %>
    <span style="font-size:10px;color:#555;"><%= product.volumes.length %> Variants</span>
  <% } %>
</div>

              <% if(!isOut) { %>
                <a href="/shop/<%= product._id %>" class="view-btn d-block text-center text-decoration-none">
                  VIEW PRODUCT
                </a>
              <% } else { %>
                <span class="view-btn d-block text-center" 
                  style="color:#444;border-color:#1a1a1a;cursor:default;">
                  SOLD OUT
                </span>
              <% } %>
            </div>

          </div>
        </div>
      </div>
    <% }) %>
  </div>
</section>

    <!-- BRAND STORY -->
    <section class="container text-center py-5 my-5">
        <div class="mb-4">
            <i class="fas fa-gem gold-text fa-2x"></i>
        </div>
        <h2 class="display-5 mb-4 gold-text">ROYAL MIST</h2>
        <p class="mx-auto text-light opacity-75" style="max-width: 800px;font-family: var(--font-main); line-height: 1.8;">
            "Founded in the heart of the French Riviera, Royal Mist has spent generations perfecting the delicate balance of rare botanicals and precious oils. Every bottle is a testament to the timeless pursuit of beauty and elegance."
        </p>
        <a href="#" class="gold-text text-decoration-none small mt-3 d-inline-block" style="letter-spacing: 2px;">READ OUR FULL STORY</a>
    </section>

    <!-- FOOTER -->
    <footer>
        <div class="container">
            <div class="row g-5 align-items-start">

                <!-- Col 1: Brand -->
                <div class="col-12 col-md-4">
                    <span class="footer-logo">ROYALMIST</span>
                    <p class="text-secondary small" style="line-height: 1.8;">
                        Exquisite fragrances designed for those who command attention and appreciate the finer things in life.
                    </p>
                </div>

                <!-- Col 2: Contact -->
                <div class="col-6 col-md-2">
                    <div class="footer-head">CONTACT US</div>
                    <p class="text-secondary small" style="line-height: 2;">
                        Other Enquiries<br>
                        +91 98765 43210<br>
                        royalmist@gmail.com
                    </p>
                </div>

                <!-- Col 3: Support -->
                <div class="col-6 col-md-2">
                    <div class="footer-head">SUPPORT</div>
                    <a href="#" class="footer-link">Newsletter</a>
                    <a href="#" class="footer-link">Community Guidelines</a>
                    <a href="#" class="footer-link">Terms & Conditions</a>
                </div>

                <!-- Col 4: Social -->
                <div class="col-12 col-md-4">
                    <div class="footer-head">FOLLOW US</div>
                    <div class="social-icons mb-3">
                        <i class="fab fa-instagram"></i>
                        <i class="fab fa-youtube"></i>
                        <i class="fab fa-twitter"></i>
                    </div>
                    <p class="text-secondary" style="font-size: 11px; margin-bottom: 0;">
                        Stay connected for exclusive launches, behind-the-scenes stories, and member-only offers.
                    </p>
                </div>

            </div>

            <!-- Footer Bottom -->
            <div class="footer-bottom">
                <p class="text-secondary mb-0" style="font-size: 11px; letter-spacing: 1px;">
                    © 2026 ROYAL MIST FRAGRANCES. ALL RIGHTS RESERVED.
                </p>
            </div>
        </div>
    </footer>
    <!-- ── LOGOUT CONFIRM MODAL ── -->
<div id="logoutConfirmOverlay" style="position:fixed;inset:0;background:rgba(0,0,0,0.88);display:flex;align-items:center;justify-content:center;z-index:9998;opacity:0;pointer-events:none;transition:opacity 0.25s ease;">
  <div style="background:#0a0a0a;border:1px solid #2a2a2a;padding:36px 32px;max-width:360px;width:90%;text-align:center;">
    <div style="width:52px;height:52px;border:1px solid var(--gold);border-radius:50%;display:flex;align-items:center;justify-content:center;margin:0 auto 16px;color:var(--gold);font-size:18px;">
      <i class="fas fa-sign-out-alt"></i>
    </div>
    <div style="font-size:14px;letter-spacing:3px;color:#fff;font-weight:600;margin-bottom:8px;">LOGOUT?</div>
    <div style="font-size:11px;color:#555;letter-spacing:1px;line-height:1.7;margin-bottom:22px;">Are you sure you want to logout of your account?</div>
    <div style="display:flex;gap:10px;">
      <button onclick="closeLogoutModal()" style="flex:1;background:transparent;border:1px solid #2a2a2a;color:#666;font-family:var(--font-main);font-size:11px;letter-spacing:2px;padding:14px;cursor:pointer;transition:0.2s;">CANCEL</button>
      <button id="confirmLogoutBtn" style="flex:1;background:var(--gold);border:none;color:#000;font-family:var(--font-main);font-size:11px;letter-spacing:2px;font-weight:700;padding:14px;cursor:pointer;transition:0.2s;">YES, LOGOUT</button>
    </div>
  </div>
</div>

    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/js/bootstrap.bundle.min.js"></script>
    <script>
const userIcon = document.getElementById("userIcon");
const dropdown = document.getElementById("dropdownMenu");

// CLICK → TOGGLE
if (userIcon && dropdown) {
    userIcon.addEventListener("click", (e) => {
        e.stopPropagation();
        const isShown = dropdown.classList.toggle("show");
           userIcon.setAttribute("aria-expanded", isShown);
    });

    window.addEventListener("click", (e) => {
            dropdown.classList.remove("show");
             userIcon.setAttribute("aria-expanded", false);
    });
}

const caret = document.querySelector("#userIcon .caret");

if (caret && dropdown) {
    caret.addEventListener("click", (e) => {
        e.stopPropagation();
        const isShown = dropdown.classList.toggle("show");
        caret.setAttribute("aria-expanded", isShown);
    });
}

// LOGOUT — show confirm modal first
const logoutBtn = document.getElementById("logoutBtn");
if (logoutBtn) {
    logoutBtn.addEventListener("click", (e) => {
        e.preventDefault();
        document.getElementById("logoutConfirmOverlay").style.opacity = "1";
        document.getElementById("logoutConfirmOverlay").style.pointerEvents = "all";
    });
}

function closeLogoutModal() {
    document.getElementById("logoutConfirmOverlay").style.opacity = "0";
    document.getElementById("logoutConfirmOverlay").style.pointerEvents = "none";
}

document.getElementById("confirmLogoutBtn").addEventListener("click", async () => {
    try {
        await fetch("/logout", { method: "POST" });
        window.location.href = "/signin";
    } catch (err) {
        console.log(err);
    }
});

document.getElementById("logoutConfirmOverlay").addEventListener("click", function(e) {
    if (e.target === this) closeLogoutModal();
});
</script>
</body>
</html>
