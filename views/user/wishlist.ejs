<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8"/>
  <meta name="viewport" content="width=device-width, initial-scale=1.0"/>
  <title>Wishlist | Royal Mist</title>
  <link href="https://fonts.googleapis.com/css2?family=Playfair+Display:wght@400;500;600;700&display=swap" rel="stylesheet"/>
  <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/css/bootstrap.min.css" rel="stylesheet"/>
  <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css"/>
  <style>
    :root { --gold: #c4a14d; --dark-bg: #000; --card-bg: #0a0a0a; --font-main: 'Playfair Display', serif; }
    * { box-sizing: border-box; margin: 0; padding: 0; }
    body { background: var(--dark-bg); color: #fff; font-family: var(--font-main); overflow-x: hidden; }

    .navbar { background: rgba(0,0,0,0.97); border-bottom: 1px solid #222; padding: 15px 0; position: sticky; top: 0; z-index: 1000; }
    .navbar-brand { color: var(--gold) !important; letter-spacing: 4px; font-weight: 700; }
    .nav-link { color: #fff !important; font-size: 12px; letter-spacing: 2px; }
    .user-dropdown { position: relative; z-index: 2000; }
    .dropdown-menu-custom { position: absolute; top: 100%; right: 0; background: #0a0a0a; border: 1px solid #222; min-width: 160px; z-index: 3000; display: none; box-shadow: 0 10px 25px rgba(0,0,0,0.5); } @media (max-width: 768px) { .dropdown-menu-custom { position: fixed; top: auto; right: 10px; left: auto; max-width: calc(100vw - 20px); } }
    .dropdown-menu-custom.show { display: block; }
    .dropdown-item-custom { color: #fff; background: none; border: none; text-decoration: none; display: block; padding: 10px 15px; width: 100%; text-align: left; font-family: var(--font-main); font-size: 13px; cursor: pointer; }
    .dropdown-item-custom:hover { color: var(--gold); background: #111; }

    .breadcrumb-wrap { background: #080808; border-bottom: 1px solid #111; padding: 12px 0; }
    .bc-item { font-size: 11px; letter-spacing: 2px; color: #555; text-decoration: none; }
    .bc-item:hover { color: var(--gold); }
    .bc-item.active { color: #888; }
    .bc-sep { color: #333; margin: 0 8px; font-size: 9px; }

    .page-header { background: linear-gradient(180deg, #080808 0%, #000 100%); border-bottom: 1px solid #111; padding: 35px 0 25px; }
    .gold-line { width: 40px; height: 2px; background: var(--gold); margin-bottom: 10px; }

    /* ── WISH ITEM — same as cart-item ── */
    .wish-item { background: #0a0a0a; border: 1px solid #1a1a1a; padding: 20px; margin-bottom: 16px; transition: border-color 0.2s; }
    .wish-item:hover { border-color: #2a2a2a; }
    .wish-item.out-of-stock { opacity: 0.55; border-color: #2a1a1a; }

    .item-img { width: 90px; height: 100px; object-fit: cover; border: 1px solid #1a1a1a; flex-shrink: 0; }
    .item-name { font-size: 16px; font-weight: 500; margin-bottom: 4px; }
    .item-meta { font-size: 11px; color: #666; letter-spacing: 1px; margin-bottom: 6px; }
    .item-frag { display: inline-block; border: 1px solid #2a2a2a; color: var(--gold); font-size: 10px; letter-spacing: 1px; padding: 2px 10px; margin-bottom: 8px; }
    .item-price { font-size: 17px; font-weight: 600; color: #fff; }
    .item-price-label { font-size: 10px; color: #555; letter-spacing: 1px; margin-bottom: 4px; }

    .unavail-badge { background: #1a0a0a; border: 1px solid #3a1a1a; color: #c0392b; font-size: 10px; letter-spacing: 2px; padding: 3px 10px; display: inline-block; margin-bottom: 6px; }

    .btn-move-cart { background: var(--gold); border: 1px solid var(--gold); color: #000; font-family: var(--font-main); font-size: 10px; letter-spacing: 2px; font-weight: 700; padding: 9px 18px; cursor: pointer; transition: all 0.2s; white-space: nowrap; }
    .btn-move-cart:hover { background: #b38f3d; border-color: #b38f3d; }

    .btn-view-product { background: transparent; border: 1px solid #2a2a2a; color: #888; font-family: var(--font-main); font-size: 10px; letter-spacing: 2px; padding: 9px 18px; text-decoration: none; display: inline-block; transition: all 0.2s; white-space: nowrap; }
    .btn-view-product:hover { border-color: var(--gold); color: var(--gold); }

    .btn-remove { background: none; border: none; color: #444; font-size: 12px; letter-spacing: 1px; cursor: pointer; padding: 4px 0; font-family: var(--font-main); transition: color 0.2s; }
    .btn-remove:hover { color: #c0392b; }

    .empty-wish { text-align: center; padding: 80px 20px; }
    .empty-wish i { font-size: 50px; color: #1a1a1a; margin-bottom: 20px; }
    .empty-wish h3 { font-size: 20px; color: #444; margin-bottom: 10px; }
    .empty-wish p { font-size: 12px; color: #333; letter-spacing: 1px; margin-bottom: 30px; }
    .btn-shop { background: var(--gold); border: none; color: #000; font-family: var(--font-main); font-size: 11px; letter-spacing: 3px; font-weight: 700; padding: 14px 40px; cursor: pointer; text-decoration: none; display: inline-block; }
    .btn-shop:hover { background: #b38f3d; color: #000; }

  


    /* ── MOBILE RESPONSIVE ── */
@media (max-width: 576px) {
  .wish-item { padding: 14px; }

  .item-img { width: 70px; height: 80px; }

  .item-name { font-size: 13px; }
  .item-meta { font-size: 10px; }
  .item-price { font-size: 14px; }

  /* Buttons stack vertically on mobile */
  .d-flex.align-items-center.justify-content-between {
    flex-direction: column;
    align-items: flex-start !important;
    gap: 10px !important;
  }

  .btn-move-cart,
  .btn-view-product {
    font-size: 9px;
    padding: 8px 12px;
    letter-spacing: 1px;
  }

  /* Toast full width on mobile */
  #toastMsg {
    left: 15px !important;
    right: 15px !important;
    transform: none !important;
    white-space: normal !important;
    width: calc(100% - 30px);
    top: 15px !important;
  }

  .page-header h1 { font-size: 1.3rem !important; }
}


  </style>
</head>
<body>

<nav class="navbar navbar-expand-lg">
  <div class="container">
    <a class="navbar-brand" href="/home"><i class="fas fa-gem me-2" style="color:var(--gold)"></i>ROYALMIST</a>
    <button class="navbar-toggler border-0" type="button" data-bs-toggle="collapse" data-bs-target="#mainNav">
      <i class="fas fa-bars text-white"></i>
    </button>
    <div class="collapse navbar-collapse" id="mainNav">
      <ul class="navbar-nav mx-auto">
        <li class="nav-item"><a class="nav-link" href="/home">HOME</a></li>
        <li class="nav-item"><a class="nav-link" href="/shop">SHOP</a></li>
        <li class="nav-item"><a class="nav-link" href="/about">ABOUT</a></li>
      </ul>
      <div class="d-flex gap-3 align-items-center">
        <a href="/wishlist"><i class="fa-solid fa-heart" style="cursor:pointer;color:var(--gold);"></i></a>
       <a href="/cart" style="position:relative;">
  <i class="fa-solid fa-bag-shopping" style="cursor:pointer;color:#fff;font-size:16px;"></i>
 <% if(locals.cartCount > 0) { %>
    <span style="position:absolute;top:-8px;right:-8px;background:var(--gold);color:#000;font-size:9px;font-weight:700;width:17px;height:17px;border-radius:50%;display:flex;align-items:center;justify-content:center;"><%= locals.cartCount %></span>
  <% } %>
</a>
        <div class="user-dropdown">
          <% if(user) { %>
            <span id="userIcon" style="cursor:pointer;color:#fff;font-size:13px;letter-spacing:1px;">
              <%= user.firstName %> <i class="fa fa-caret-down"></i>
            </span>
            <div id="dropdownMenu" class="dropdown-menu-custom">
              <a href="/account" class="dropdown-item-custom">Account</a>
              <button id="logoutBtn" class="dropdown-item-custom">Logout</button>
            </div>
          <% } else { %>
            <a href="/signin"><i class="fa fa-user" style="color:#fff"></i></a>
          <% } %>
        </div>
      </div>
    </div>
  </div>
</nav>

<div class="breadcrumb-wrap">
  <div class="container d-flex align-items-center">
    <a href="/home" class="bc-item">HOME</a>
    <span class="bc-sep"><i class="fas fa-chevron-right" style="font-size:8px;"></i></span>
    <span class="bc-item active">WISHLIST</span>
  </div>
</div>

<div class="page-header">
  <div class="container">
    <div class="gold-line"></div>
    <h1 style="font-size:1.8rem;letter-spacing:4px;font-weight:600;">
      MY WISHLIST
      <% if(totalItems > 0) { %>
        <span style="font-size:14px;color:#555;letter-spacing:2px;margin-left:10px;">
          (<%= totalItems %> ITEM<%= totalItems > 1 ? 'S' : '' %>)
        </span>
      <% } %>
    </h1>
  </div>
</div>

<div class="container py-5">
  <% if(wishlistItems.length === 0) { %>
    <div class="empty-wish">
      <i class="far fa-heart"></i>
      <h3>Your Wishlist Is Empty</h3>
      <p>Save your favourite fragrances here</p>
      <a href="/shop" class="btn-shop">EXPLORE COLLECTION</a>
    </div>
  <% } else { %>
    <div class="col-12">
      <% wishlistItems.forEach((item, index) => { %>
        <%
          const prod      = item.product;
       const isOut = !prod.volumes || prod.volumes.length === 0 || 
  prod.volumes.every(v => v.stock === 0);
          const basePrice = prod.volumes && prod.volumes[0] ? prod.volumes[0].price : 0;
        %>
        <div class="wish-item <%= isOut ? 'out-of-stock' : '' %>" id="wish-item-<%= index %>">
          <div class="d-flex gap-3 align-items-start">

            <img
              src="<%= prod.images && prod.images[0] ? prod.images[0] : '/images/placeholder.jpg' %>"
              class="item-img"
              alt="<%= prod.name %>"
              style="<%= isOut ? 'filter:grayscale(60%) brightness(0.6)' : '' %>"
            />

            <div class="flex-grow-1">
              <% if(isOut) { %>
                <span class="unavail-badge">
                  <i class="fas fa-exclamation-triangle me-1"></i>OUT OF STOCK
                </span>
              <% } %>

              <div class="item-name"><%= prod.name %></div>
              <div class="item-meta"><%= prod.category ? prod.category.name : '' %> · <%= prod.fragranceType %></div>
              <span class="item-frag"><%= prod.fragranceType %></span>

              <div class="d-flex align-items-center justify-content-between flex-wrap gap-3 mt-2">
                <div>
                  <div class="item-price-label">FROM</div>
                  <div class="item-price">₹<%= basePrice.toLocaleString('en-IN') %></div>
                </div>

                <div class="d-flex gap-2 flex-wrap align-items-center">
                  <a href="/shop/<%= prod._id %>" class="btn-view-product">
                    <i class="fas fa-eye me-1"></i>VIEW
                  </a>
                  <% if(!isOut) { %>
    <button class="btn-move-cart" onclick="moveToCart('<%= prod._id %>', '<%= index %>')">
      <i class="fas fa-shopping-bag me-1"></i>MOVE TO CART
    </button>
  <% } else { %>
    <button class="btn-move-cart" disabled style="background:#1a1a1a;color:#444;border:1px solid #2a2a2a;cursor:not-allowed;">
      <i class="fas fa-ban me-1"></i>OUT OF STOCK
    </button>
  <% } %>
                </div>
              </div>

              <button class="btn-remove mt-3" onclick="removeFromWishlist('<%= prod._id %>', '<%= index %>')">
                <i class="fas fa-times me-1"></i>REMOVE
              </button>
            </div>
          </div>
        </div>
      <% }) %>
    </div>
  <% } %>
</div>

<footer style="border-top:1px solid #222;padding:50px 0 25px;font-family:var(--font-main);margin-top:40px;">
  <div class="container">
    <div style="border-top:1px solid #1a1a1a;padding-top:20px;text-align:center;">
      <p class="text-secondary mb-0" style="font-size:11px;letter-spacing:1px;">© 2026 ROYAL MIST FRAGRANCES. ALL RIGHTS RESERVED.</p>
    </div>
  </div>
</footer>

<div id="toastMsg" style="
  display:none;
  position: fixed;
  top: 20px;
  left: 50%;
  transform: translateX(-50%);
  background: black;
  color: #c4a14d;
  border: 2px solid #c4a14d;
  padding: 15px 25px;
  font-weight: 700;
  border-radius: 8px;
  font-family: 'Playfair Display', serif;
  z-index: 9999;
  align-items: center;
  gap: 10px;
  box-shadow: 0 0 10px rgba(0,0,0,0.5);
  white-space: nowrap;
">
  <span id="toastIcon" style="font-size:18px;">✅</span>
  <span id="toastText"></span>
</div>
<script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/js/bootstrap.bundle.min.js"></script>
<script>
function showToast(msg, isError = false) {
  const t    = document.getElementById("toastMsg");
  const icon = document.getElementById("toastIcon");
  const text = document.getElementById("toastText");

  text.innerText = msg;
  icon.innerText = isError ? "❌" : "✅";

  t.style.color       = isError ? "#c0392b" : "#c4a14d";
  t.style.borderColor = isError ? "#c0392b" : "#c4a14d";

  t.style.display = "flex";
  clearTimeout(window._toastTimer);
  window._toastTimer = setTimeout(() => { t.style.display = "none"; }, 3000);
}

const userIcon = document.getElementById("userIcon");
const dropdownMenu = document.getElementById("dropdownMenu");
if (userIcon && dropdownMenu) {
  userIcon.addEventListener("click", e => { e.stopPropagation(); dropdownMenu.classList.toggle("show"); });
  window.addEventListener("click", () => dropdownMenu.classList.remove("show"));
}
const logoutBtn = document.getElementById("logoutBtn");
if (logoutBtn) {
  logoutBtn.addEventListener("click", async () => {
    await fetch("/logout", { method: "POST" });
    window.location.href = "/signin";
  });
}

async function removeFromWishlist(productId, index) {
  showConfirmToast("Remove this item from wishlist?", () => doRemove(productId, index));
}

async function doRemove(productId, index) {// ← ADD THIS
  try {
    const res  = await fetch("/wishlist/remove", {
      method: "POST",
      headers: { "Content-Type": "application/json" },
      body: JSON.stringify({ productId }),
    });
    const data = await res.json();
    if (data.success) {
      document.getElementById("wish-item-" + index).remove();
     showToast("✓ Removed from wishlist");
      if (data.totalItems === 0) setTimeout(() => location.reload(), 800);
    } else {
      showToast(data.message, true);
    }
  } catch (err) {
    showToast("Something went wrong", true);
  }
}

async function moveToCart(productId, index) {
  showConfirmToast(
    "Move this item to cart?",
    () => doMoveToCart(productId, index),
    "YES, MOVE"
  );
}

async function doMoveToCart(productId, index) {
  try {
    const res  = await fetch("/wishlist/move-to-cart", {
      method: "POST",
      headers: { "Content-Type": "application/json" },
      body: JSON.stringify({ productId }),
    });
    const data = await res.json();

    if (data.success) {
      if (data.alreadyInCart) {
        showToast("Already in cart!", true);
      } else {
        document.getElementById("wish-item-" + index).remove();
        showToast("Moved to cart!");
        setTimeout(() => { window.location.href = "/cart"; }, 900);
      }
    } else {
      showToast(data.message, true);
    }
  } catch (err) {
    showToast("Something went wrong", true);
  }
}
   

function showConfirmToast(msg, onConfirm, confirmLabel = "YES, REMOVE") {
  const existing = document.getElementById("confirmToast");
  if(existing) existing.remove();

  const div = document.createElement("div");
  div.id = "confirmToast";
  div.style.cssText = `
    position:fixed;top:20px;left:50%;transform:translateX(-50%);
    background:#0a0a0a;border:1px solid #c4a14d;color:#fff;
    padding:20px 28px;z-index:99999;font-family:'Playfair Display',serif;
    box-shadow:0 10px 30px rgba(0,0,0,0.8);min-width:300px;text-align:center;
  `;
  div.innerHTML = `
    <div style="font-size:12px;letter-spacing:1px;margin-bottom:16px;color:#aaa;">${msg}</div>
    <div style="display:flex;gap:10px;justify-content:center;">
      <button id="confirmYes" style="background:var(--gold);border:none;color:#000;font-family:'Playfair Display',serif;font-size:10px;letter-spacing:2px;font-weight:700;padding:9px 24px;cursor:pointer;">
        ${confirmLabel}
      </button>
      <button id="confirmNo" style="background:transparent;border:1px solid #333;color:#888;font-family:'Playfair Display',serif;font-size:10px;letter-spacing:2px;padding:9px 24px;cursor:pointer;">
        CANCEL
      </button>
    </div>
  `;
  document.body.appendChild(div);

  document.getElementById("confirmYes").onclick = () => { div.remove(); onConfirm(); };
  document.getElementById("confirmNo").onclick  = () => div.remove();
}


</script>
</body>
</html>