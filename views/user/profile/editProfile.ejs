<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">
<title>Edit Profile</title>
<link href="https://fonts.googleapis.com/css2?family=Playfair+Display:wght@400;600;700&display=swap" rel="stylesheet">
<style>
:root {
    --gold: #c4a14d;
    --bg: #000;
}
* { box-sizing: border-box; margin: 0; padding: 0; }
body {
    background: var(--bg);
    color: #fff;
    font-family: 'Playfair Display', serif;
}

/* ── NAV ── */


/* ── CONTAINER ── */
.container {
    max-width: 600px;
    margin: 0 auto;
    padding: 50px 20px 80px;
}
.title {
    font-size: 28px;
    margin-bottom: 8px;
    letter-spacing: 2px;
}
.subtitle {
    color: #777;
    font-size: 12px;
    letter-spacing: 2px;
    margin-bottom: 36px;
    text-transform: uppercase;
}

/* ── FORM ── */
.form { display: flex; flex-direction: column; gap: 24px; }
.row { display: flex; gap: 24px; }
.row .field { flex: 1; }

.field label {
    font-size: 11px;
    color: var(--gold);
    letter-spacing: 2px;
    margin-bottom: 8px;
    display: block;
    text-transform: uppercase;
}
.field input {
    width: 100%;
    padding: 12px 14px;
    background: #000;
    border: 1px solid #333;
    color: #fff;
    font-family: 'Playfair Display', serif;
    font-size: 14px;
    outline: none;
    transition: border-color .2s;
}
.field input:focus { border-color: var(--gold); }
.field input[readonly] { color: #888; cursor: default; }
.field input::placeholder { color: #444; }

/* email row */
.email-row { display: flex; gap: 0; }
.email-row input { flex: 1; border-right: none; }
.btn-change {
    background: transparent;
    border: 1px solid #333;
    border-left: none;
    color: var(--gold);
    padding: 0 16px;
    font-size: 10px;
    letter-spacing: 2px;
    font-family: 'Playfair Display', serif;
    cursor: pointer;
    white-space: nowrap;
    transition: .2s;
}
.btn-change:hover { background: var(--gold); color: #000; border-color: var(--gold); }

/* buttons */
.btn-gold-fill {
    background: var(--gold);
    color: #000;
    border: none;
    padding: 13px 24px;
    font-size: 12px;
    letter-spacing: 2px;
    cursor: pointer;
    font-family: 'Playfair Display', serif;
    transition: .2s;
}
.btn-gold-fill:hover { background: #d4b05d; }
.btn-gold-fill:disabled { opacity: 0.6; cursor: not-allowed; }
.btn-gold {
    border: 1px solid var(--gold);
    color: var(--gold);
    background: transparent;
    padding: 13px 24px;
    font-size: 12px;
    letter-spacing: 2px;
    cursor: pointer;
    font-family: 'Playfair Display', serif;
    transition: .2s;
}
.btn-gold:hover { background: var(--gold); color: #000; }
.actions { display: flex; gap: 14px; flex-wrap: wrap; }

.error { color: red; font-size: 12px; margin-top: 5px; font-family: sans-serif; }
/* ── TOAST ── */
#successToast {
    display: none;
    position: fixed;
    top: 20px;
    left: 50%;
    transform: translateX(-50%);
    background: #000;
    color: var(--gold);
    border: 2px solid var(--gold);
    padding: 14px 24px;
    font-weight: 700;
    border-radius: 4px;
    font-family: 'Playfair Display', serif;
    z-index: 9999;
    align-items: center;
    gap: 10px;
    white-space: nowrap;
}

/* ── MODAL ── */
.modal {
    position: fixed;
    inset: 0;
    background: rgba(0,0,0,0.88);
    display: none;
    justify-content: center;
    align-items: center;
    z-index: 999;
    padding: 20px;
}
.modal.active { display: flex; }
.modal-box {
    background: #000;
    border: 1px solid #2a2a2a;
    padding: 36px 28px;
    width: 100%;
    max-width: 380px;
}
.modal-title { font-size: 20px; color: #fff; margin-bottom: 6px; }
.modal-sub {
    font-size: 10px;
    color: #555;
    letter-spacing: 3px;
    text-transform: uppercase;
    margin-bottom: 28px;
}
.modal-box .field { margin-bottom: 20px; }
.modal-err {
    color: red;
    font-size: 12px;
    margin-top: -12px;
    margin-bottom: 14px;
    display: none;
     font-family: sans-serif;
}
.modal-actions { display: flex; gap: 12px; margin-top: 24px; flex-wrap: wrap; }
.modal-actions .btn-gold-fill { flex: 1; padding: 12px; text-align: center; }
.modal-divider { border: none; border-top: 1px solid #1a1a1a; margin: 24px 0; }

input:-webkit-autofill,
input:-webkit-autofill:focus,
input:-webkit-autofill:hover {
    -webkit-box-shadow: 0 0 0px 1000px #000 inset !important;
    -webkit-text-fill-color: #fff !important;
    transition: background-color 5000s ease-in-out 0s;
}

/* ── MOBILE ── */
@media (max-width: 768px) {
    .top-bar { flex-direction: column; align-items: center; text-align: center; padding: 14px 16px; gap: 10px; }
    .nav-menu { justify-content: center; gap: 14px; }
    .nav-menu a { font-size: 12px; }
    .nav-actions { justify-content: center; }
    .container { padding: 36px 16px 60px; }
    .title { font-size: 22px; }
    .row { flex-direction: column; gap: 20px; }
    .actions { flex-direction: column; }
    .actions .btn-gold-fill,
    .actions .btn-gold { width: 100%; text-align: center; }
    .modal-actions { flex-direction: column; }
    .modal-actions .btn-gold-fill,
    .modal-actions .btn-gold { width: 100%; text-align: center; }
}
@media (max-width: 480px) {
    .nav-logo { font-size: 15px; letter-spacing: 2px; }
    .btn-nav, .btn-nav-outline { padding: 6px 12px; font-size: 10px; }
    .nav-menu a { font-size: 11px; letter-spacing: 1px; }
    .modal-box { padding: 24px 18px; }
}
</style>
</head>
<body>

<!-- NAV -->


<!-- MAIN -->
<div class="container">
    <div class="title">Edit Profile</div>
    <div class="subtitle">Manage your personal info</div>

    <form id="form" class="form" novalidate>

        <div class="row">
            <div class="field">
                <label>First Name</label>
                <input id="firstName" type="text" value="<%= user.firstName %>">
                <div class="error" id="errFirst"></div>
            </div>
            <div class="field">
                <label>Last Name</label>
                <input id="lastName" type="text" value="<%= user.lastName %>">
                <div class="error" id="errLast"></div>
            </div>
        </div>

        <div class="field">
            <label>Email</label>
            <div class="email-row">
                <input id="email" type="email" value="<%= user.email %>" readonly>
                <button type="button" class="btn-change" onclick="openModal()">CHANGE</button>
            </div>
            <div class="error" id="errEmail"></div>
        </div>

        <div class="field">
            <label>Phone</label>
            <input id="phone" type="tel" value="<%= user.phone %>" maxlength="10">
            <div class="error" id="errPhone"></div>
        </div>

        <div class="field">
            <label>Referral Code</label>
            <input id="referral" type="text" value="<%= user.referralCode || '' %>">
        </div>

        <div class="actions">
            <button type="submit" class="btn-gold-fill" id="saveBtn">SAVE</button>
            <button type="button" class="btn-gold" onclick="history.back()">CANCEL</button>
        </div>

    </form>
</div>

<!-- TOAST -->
<div id="successToast">
    <span id="toastIcon">✅</span>
    <span id="toastText"></span>
</div>

<!-- EMAIL CHANGE MODAL -->
<div class="modal" id="modal">
    <div class="modal-box">

        <div id="step1">
            <div class="modal-title">Change Email</div>
            <div class="modal-sub">Enter your new email address</div>
            <div class="field">
                <label>New Email</label>
                <input id="newEmail" type="email" placeholder="new@example.com">
            </div>
            <div class="modal-err" id="modalErr"></div>
            <div class="modal-actions">
                <button class="btn-gold-fill" onclick="sendOtp()">SEND OTP</button>
                <button class="btn-gold" onclick="closeModal()">CANCEL</button>
            </div>
        </div>

        <div id="step2" style="display:none;">
            <div class="modal-title">Verify OTP</div>
            <div class="modal-sub">Check your new email inbox</div>
            <hr class="modal-divider">
            <div class="field">
                <label>Enter OTP</label>
                <input id="otpInput" type="text" placeholder="6-digit OTP" maxlength="6">
            </div>
            <div class="modal-err" id="otpErr"></div>
            <div class="modal-actions">
                <button class="btn-gold-fill" onclick="verifyOtp()">VERIFY & UPDATE</button>
                <button class="btn-gold" onclick="closeModal()">CANCEL</button>
            </div>
        </div>

    </div>
</div>

<script>
const saveBtn = document.getElementById("saveBtn");

function showToast(msg, type = "success") {
    const toast = document.getElementById("successToast");
    document.getElementById("toastText").innerText = msg;
    document.getElementById("toastIcon").innerText = type === "success" ? "✅" : "⚠️";
    toast.style.display = "flex";
    setTimeout(() => toast.style.display = "none", 2200);
}

function openModal() {
    document.getElementById("newEmail").value = "";
    document.getElementById("otpInput").value = "";
    document.getElementById("step1").style.display = "block";
    document.getElementById("step2").style.display = "none";
    document.getElementById("modalErr").style.display = "none";
    document.getElementById("otpErr").style.display = "none";
    document.getElementById("modal").classList.add("active");
}
function closeModal() {
    document.getElementById("modal").classList.remove("active");
}
document.getElementById("modal").addEventListener("click", (e) => {
    if (e.target === document.getElementById("modal")) closeModal();
});

async function sendOtp() {
    const val = document.getElementById("newEmail").value.trim();
    const err = document.getElementById("modalErr");
    if (!val || !/^[^\s@]+@[^\s@]+\.[^\s@]+$/.test(val)) {
        err.innerText = "Please enter a valid email address";
        err.style.display = "block"; return;
    }
    err.style.display = "none";
    try {
        const res = await fetch("/send-email-otp", {
            method: "POST",
            headers: { "Content-Type": "application/json" },
            body: JSON.stringify({ newEmail: val })
        });
        const data = await res.json();
        
        // ── HANDLE GOOGLE USER ERROR ──
        if (!data.success && data.googleUser) {
            closeModal();
            showToast('Google users cannot change email', 'fail');
            return;
        }
        
        if (data.success) {
            document.getElementById("step1").style.display = "none";
            document.getElementById("step2").style.display = "block";
        } else {
            err.innerText = data.message || "Failed to send OTP";
            err.style.display = "block";
        }
    } catch {
        err.innerText = "Something went wrong. Try again.";
        err.style.display = "block";
    }
}

async function verifyOtp() {
    const otp = document.getElementById("otpInput").value.trim();
    const err = document.getElementById("otpErr");
    if (!/^\d{6}$/.test(otp)) {
        err.innerText = "Enter a valid 6-digit OTP";
        err.style.display = "block"; return;
    }
    err.style.display = "none";
    try {
        const res = await fetch("/verify-email-otp", {
            method: "POST",
            headers: { "Content-Type": "application/json" },
            body: JSON.stringify({ otp })
        });
               const data = await res.json();
        
        // ── HANDLE GOOGLE USER ERROR ──
        if (!data.success && data.googleUser) {
            closeModal();
            showToast('Google users cannot change email', 'fail');
            return;
        }
        
        if (data.success) {
            document.getElementById("email").value = document.getElementById("newEmail").value.trim();
            closeModal();
            showToast("Email updated successfully", "success");
        } else {
            err.innerText = data.message || "Invalid OTP";
            err.style.display = "block";
        }
    } catch {
        err.innerText = "Something went wrong. Try again.";
        err.style.display = "block";
    }
}
document.getElementById("phone").addEventListener("input", function() {
    this.value = this.value.replace(/\D/g, "");
    if (this.value.length > 10) {
        this.value = this.value.slice(0, 10);
    }
});

document.getElementById("form").addEventListener("submit", async (e) => {
    e.preventDefault();
    
    const first = document.getElementById("firstName").value.trim();
    const last  = document.getElementById("lastName").value.trim();
    const phone = document.getElementById("phone").value.trim();

    document.querySelectorAll(".error").forEach(el => el.innerText = "");

    let valid = true;
    if (!first) { document.getElementById("errFirst").innerText = "First name required"; valid = false; }
    if (!last)  { document.getElementById("errLast").innerText = "Last name required"; valid = false; }
    if (phone && !/^[6-9]\d{9}$/.test(phone)) {
        document.getElementById("errPhone").innerText = "Valid 10-digit number required"; valid = false;
    }
    if (!valid) return;

    // ── SHOW CONFIRMATION MODAL ──
    document.getElementById("confirmSaveModal").style.display = "flex";
});

function cancelSave() {
    document.getElementById("confirmSaveModal").style.display = "none";
}

async function confirmSave() {
    const saveBtn = document.getElementById("saveBtn");
    saveBtn.disabled = true;
    saveBtn.innerText = "SAVING...";

    document.getElementById("confirmSaveModal").style.display = "none";

    const first = document.getElementById("firstName").value.trim();
    const last  = document.getElementById("lastName").value.trim();
    const phone = document.getElementById("phone").value.trim();

    try {
        const res = await fetch("/updateProfile", {
            method: "POST",
            headers: { "Content-Type": "application/json" },
            body: JSON.stringify({
                firstName: first,
                lastName: last,
                phoneNumber: phone,
                referralCode: document.getElementById("referral").value
            })
        });
        const data = await res.json();
        if (data.success) {
            showToast("Profile Updated", "success");
            setTimeout(() => window.location.href = "/account", 1500);
        } else {
            showToast(data.message || "Update failed. Try again.", "fail");
        }
    } catch {
        showToast("Something went wrong. Try again.", "fail");
   } finally {
    saveBtn.disabled = false;
    saveBtn.innerText = "SAVE";
}
}
</script>
<!-- ── CONFIRMATION MODAL ── -->
<div id="confirmSaveModal" style="display:none;position:fixed;inset:0;background:rgba(0,0,0,0.6);z-index:1000;align-items:center;justify-content:center;">
    <div style="background:#0a0a0a;border:1px solid #1a1a1a;padding:32px;width:90%;max-width:400px;border-radius:8px;box-shadow:0 8px 32px rgba(0,0,0,0.5);">
        <h3 style="color:#fff;font-size:16px;margin-bottom:12px;letter-spacing:1px;font-family:'Playfair Display',serif;">CONFIRM SAVE</h3>
        <p style="color:#888;font-size:13px;margin-bottom:24px;line-height:1.6;">Are you sure you want to save these profile changes?</p>
        
        <div style="display:flex;gap:12px;justify-content:flex-end;">
            <button onclick="cancelSave()" style="background:transparent;border:1px solid #333;color:#666;font-family:'Playfair Display',serif;font-size:11px;letter-spacing:2px;padding:10px 20px;cursor:pointer;border-radius:4px;transition:0.2s;">
                CANCEL
            </button>
            <button onclick="confirmSave()" style="background:#c4a14d;border:none;color:#000;font-family:'Playfair Display',serif;font-size:11px;letter-spacing:2px;font-weight:700;padding:10px 24px;cursor:pointer;border-radius:4px;transition:0.2s;">
                YES, SAVE
            </button>
        </div>
    </div>
</div>

</body>
</html>