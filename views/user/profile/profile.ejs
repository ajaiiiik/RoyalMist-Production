<div id="logoutConfirmOverlay" style="position:fixed;inset:0;background:rgba(0,0,0,0.88);display:flex;align-items:center;justify-content:center;z-index:9998;opacity:0;pointer-events:none;transition:opacity 0.25s ease;">
  <div style="background:#0a0a0a;border:1px solid #2a2a2a;padding:36px 32px;max-width:360px;width:90%;text-align:center;">
    <div style="width:52px;height:52px;border:1px solid var(--gold);border-radius:50%;display:flex;align-items:center;justify-content:center;margin:0 auto 16px;color:var(--gold);font-size:18px;">
      <i class="fas fa-sign-out-alt"></i>
    </div>
    <div style="font-size:14px;letter-spacing:3px;color:#fff;font-weight:600;margin-bottom:8px;">LOGOUT?</div>
    <div style="font-size:11px;color:#555;letter-spacing:1px;line-height:1.7;margin-bottom:22px;">Are you sure you want to logout of your account?</div>
    <div style="display:flex;gap:10px;">
      <button onclick="closeLogoutModal()" style="flex:1;background:transparent;border:1px solid #333;color:#555;font-family:'Playfair Display',serif;font-size:11px;letter-spacing:2px;padding:14px;cursor:pointer;transition:0.2s;">CANCEL</button>
      <button id="confirmLogoutBtn" style="flex:1;background:var(--gold);border:none;color:#000;font-family:'Playfair Display',serif;font-size:11px;letter-spacing:2px;font-weight:700;padding:14px;cursor:pointer;transition:0.2s;">YES, LOGOUT</button>
    </div>
  </div>
</div>

<script src="https://cdnjs.cloudflare.com/ajax/libs/cropperjs/1.5.13/cropper.min.js"></script>
<script>
const profileWrapper = document.getElementById("profileWrapper");
const sourceModal    = document.getElementById("sourceModal");
const cropModal      = document.getElementById("cropModal");
const cropImage      = document.getElementById("cropImage");
const cropSaving     = document.getElementById("cropSaving");
const galleryInput   = document.getElementById("profileInputGallery");

let cropper;

document.getElementById("uploadBtn").addEventListener("click", (e) => {
    e.stopPropagation();
    sourceModal.classList.add("active");
});
document.getElementById("chooseGallery").addEventListener("click", () => {
    sourceModal.classList.remove("active");
    galleryInput.click();
});
document.getElementById("removePhoto").addEventListener("click", async () => {
    sourceModal.classList.remove("active");
    try {
        const res  = await fetch("/removeProfileImage", { method: "POST" });
        const data = await res.json();
        if (data.success) {
            profileWrapper.innerHTML = `👤<div class="plus" id="uploadBtn" style="cursor:pointer">+</div>`;
            document.getElementById("uploadBtn").addEventListener("click", (e) => {
                e.stopPropagation();
                sourceModal.classList.add("active");
            });
        } else { alert("Failed to remove photo."); }
    } catch (err) { alert("Error removing photo."); }
});
document.getElementById("sourceCancel").addEventListener("click", () => sourceModal.classList.remove("active"));
sourceModal.addEventListener("click", (e) => { if (e.target === sourceModal) sourceModal.classList.remove("active"); });

function handleFile(e) {
    const file = e.target.files[0];
    if (!file) return;
      const allowed = ["image/jpeg", "image/png", "image/webp"];
    if (!allowed.includes(file.type)) {
        e.target.value = "";
        showToast("Only JPEG, PNG, WEBP allowed", "fail");
        return;
    }
    e.target.value = "";
    const reader = new FileReader();
    reader.onload = function(ev) {
        cropImage.src = ev.target.result;
        cropModal.classList.add("active");
        if (cropper) cropper.destroy();
        cropper = new Cropper(cropImage, {
            aspectRatio: 1, viewMode: 1, dragMode: "move", autoCropArea: 0.9, responsive: true
        });
    };
    reader.readAsDataURL(file);
}
galleryInput.addEventListener("change", handleFile);

function closeCrop() {
    cropModal.classList.remove("active");
    if (cropper) { cropper.destroy(); cropper = null; }
}
document.getElementById("cropCancelBtn").addEventListener("click", closeCrop);
document.getElementById("cropClose").addEventListener("click", closeCrop);

document.getElementById("cropSaveBtn").addEventListener("click", async () => {
    const canvas = cropper.getCroppedCanvas({ width: 200, height: 200 });
    cropSaving.style.display = "block";
    document.getElementById("cropSaveBtn").disabled = true;
    canvas.toBlob(async (blob) => {
        const formData = new FormData();
        formData.append("profileImage", blob, "profile.jpg");
        try {
            const res  = await fetch("/updateProfileImage", { method: "POST", body: formData });
            const data = await res.json();
            if (data.success) {
                let img = profileWrapper.querySelector("img");
                if (!img) {
                    profileWrapper.innerHTML = "";
                    img = document.createElement("img");
                    img.style.cssText = "width:80px;height:80px;border-radius:50%;object-fit:cover;";
                    profileWrapper.appendChild(img);
                    const plusBtn = document.createElement("div");
                    plusBtn.id = "uploadBtn";
                    plusBtn.className = "plus";
                    plusBtn.textContent = "+";
                    plusBtn.style.cursor = "pointer";
                    profileWrapper.appendChild(plusBtn);
                    plusBtn.addEventListener("click", (e) => {
                        e.stopPropagation();
                        sourceModal.classList.add("active");
                    }); 
                }
                img.src = data.imageUrl + "?t=" + Date.now();
                closeCrop();
            } else { alert("Failed to save image. Try again."); }
        } catch { alert("Upload failed. Check your connection."); }
        finally {
            cropSaving.style.display = "none";
            document.getElementById("cropSaveBtn").disabled = false;
        }
    }, "image/jpeg", 0.9);
});

document.getElementById("logoutBtn").addEventListener("click", () => {
    document.getElementById("logoutConfirmOverlay").style.opacity = "1";
    document.getElementById("logoutConfirmOverlay").style.pointerEvents = "all";
});

function closeLogoutModal() {
    document.getElementById("logoutConfirmOverlay").style.opacity = "0";
    document.getElementById("logoutConfirmOverlay").style.pointerEvents = "none";
}

document.getElementById("confirmLogoutBtn").addEventListener("click", () => {
    fetch("/logout", { method: "POST" })
        .then(() => window.location.href = "/signin");
});

document.getElementById("logoutConfirmOverlay").addEventListener("click", function(e) {
    if (e.target === this) closeLogoutModal();
});

function showToast(msg, type) {
    const t = document.getElementById("toast");
    t.innerHTML = type === "fail" ? "⚠️ " + msg : "✅ " + msg;
    t.style.color = type === "fail" ? "#ff4444" : "#c4a14d";
    t.style.borderColor = type === "fail" ? "#ff4444" : "#c4a14d";
    t.style.display = "block";

    setTimeout(() => {
        t.style.display = "none";
    }, 2500);
}

const editModal = document.getElementById("editModal");
let currentEditId = null;

function openEditModal(addressId) {
    currentEditId = addressId;
    ["e_errName","e_errAddr1","e_errCity","e_errState","e_errZip"]
        .forEach(id => document.getElementById(id).style.display = "none");
    fetch("/getAddress/" + addressId)
        .then(res => res.json())
        .then(data => {
            if (data.success) {
                const a = data.address;
                document.getElementById("e_fullName").value    = a.fullName || "";
                document.getElementById("e_addr1").value       = a.addressLine1 || "";
                document.getElementById("e_addr2").value       = a.addressLine2 || "";
                document.getElementById("e_city").value        = a.city || "";
                document.getElementById("e_state").value       = a.state || "";
                document.getElementById("e_zip").value         = a.zipCode || "";
                document.getElementById("e_country").value     = a.country || "IN";
                document.getElementById("e_addressType").value = a.addressType || "home";
                editModal.classList.add("active");
            } else { showToast("Failed to load address.", "fail"); }
        })
        .catch(() => showToast("Something went wrong.", "fail"));
}

function closeEditModal() {
    editModal.classList.remove("active");
    currentEditId = null;
}

document.getElementById("editModalClose").addEventListener("click", closeEditModal);
document.getElementById("editCancelBtn").addEventListener("click", closeEditModal);
editModal.addEventListener("click", (e) => { if (e.target === editModal) closeEditModal(); });

document.getElementById("editSaveBtn").addEventListener("click", async () => {
    const fullName = document.getElementById("e_fullName").value.trim();
    const addr1    = document.getElementById("e_addr1").value.trim();
    const addr2    = document.getElementById("e_addr2").value.trim();
    const city     = document.getElementById("e_city").value.trim();
    const state    = document.getElementById("e_state").value.trim();
    const zip      = document.getElementById("e_zip").value.trim();
    const country  = document.getElementById("e_country").value;
    const addrType = document.getElementById("e_addressType").value;

    ["e_errName","e_errAddr1","e_errCity","e_errState","e_errZip"]
        .forEach(id => document.getElementById(id).style.display = "none");

    let valid = true;
    if (!fullName) { document.getElementById("e_errName").style.display  = "block"; valid = false; }
    if (!addr1)    { document.getElementById("e_errAddr1").style.display = "block"; valid = false; }
    if (!city)     { document.getElementById("e_errCity").style.display  = "block"; valid = false; }
    if (!state)    { document.getElementById("e_errState").style.display = "block"; valid = false; }
    if (!zip || !/^[a-zA-Z0-9\s\-]{3,10}$/.test(zip)) { document.getElementById("e_errZip").style.display = "block"; valid = false; }
    if (!valid) return;

    const saveBtn = document.getElementById("editSaveBtn");
    saveBtn.disabled = true;
    saveBtn.innerText = "SAVING...";

    try {
        const res = await fetch("/editAddress/" + currentEditId, {
            method: "POST",
            headers: { "Content-Type": "application/json" },
            body: JSON.stringify({ fullName, addressLine1: addr1, addressLine2: addr2, city, state, country, zipCode: zip, addressType: addrType })
        });
        const data = await res.json();
        if (data.success) {
            showToast("Address updated successfully", "success");
            setTimeout(() => location.reload(), 1500);
        } else { showToast(data.message || "Failed to update.", "fail"); }
    } catch { showToast("Something went wrong.", "fail"); }
    finally {
        saveBtn.disabled = false;
        saveBtn.innerText = "SAVE CHANGES";
    }
});



const confirmModal = document.getElementById("confirmModal");
let pendingDeleteId = null;

function confirmDelete(addressId) {
    pendingDeleteId = addressId;
    confirmModal.classList.add("active");
}

document.getElementById("confirmNo").addEventListener("click", () => {
    confirmModal.classList.remove("active");
    pendingDeleteId = null;
});

document.getElementById("confirmYes").addEventListener("click", () => {
    confirmModal.classList.remove("active");
    fetch('/deleteAddress/' + pendingDeleteId, { method: 'DELETE' })
        .then(res => res.json())
        .then(data => {
            if (data.success) {
              showToast("Address deleted", "success");
                setTimeout(() => location.reload(), 1500);
            } else { showToast("Failed to delete. Try again.", "fail"); }
        })
        .catch(() => showToast("Something went wrong.", "fail"));
    pendingDeleteId = null;
});

const passwordModal = document.getElementById("passwordModal");

// Open modal
document.getElementById("changePasswordBtn").addEventListener("click", async () => {

    // check if google user
    const res = await fetch("/checkAuthType");
    const data = await res.json();

    if (data.googleUser) {
        showToast("You logged in using Google. Password change not allowed.", "fail");
        return;
    }

    passwordModal.classList.add("active");
});

// close
function closePasswordModal() {
    passwordModal.classList.remove("active");
    document.getElementById("oldPassword").value = "";
    document.getElementById("newPassword").value = "";
    document.getElementById("confirmPassword").value = "";
    ["errOld","errNew","errConfirm"].forEach(id => {
        document.getElementById(id).style.display = "none";
    });
}

document.getElementById("passwordClose").onclick = closePasswordModal;
document.getElementById("passwordCancel").onclick = closePasswordModal;


// SAVE PASSWORD
document.getElementById("savePasswordBtn").addEventListener("click", async () => {

    const oldPass = document.getElementById("oldPassword").value.trim();
    const newPass = document.getElementById("newPassword").value.trim();
    const confirmPass = document.getElementById("confirmPassword").value.trim();

    // reset errors 
    ["errOld","errNew","errConfirm"].forEach(id => {
        document.getElementById(id).style.display = "none";
    });


    let valid = true;

if (!oldPass) {
    document.getElementById("errOld").textContent = "Old password is required";
    document.getElementById("errOld").style.display = "block";
    valid = false;
}

if (!newPass) {
    document.getElementById("errNew").textContent = "New password is required";
    document.getElementById("errNew").style.display = "block";
    valid = false;
} else if (!validatePassword(newPass)) {
    document.getElementById("errNew").textContent =
        "Password must be 8+ chars, include uppercase, lowercase & number";
    document.getElementById("errNew").style.display = "block";
    valid = false;
}



    if (newPass !== confirmPass) {
        document.getElementById("errConfirm").style.display = "block";
        valid = false;
    }

    if (!valid) return;

    try {
        const res = await fetch("/changePassword", {
            method: "POST",
            headers: { "Content-Type": "application/json" },
            body: JSON.stringify({ oldPassword: oldPass, newPassword: newPass })
        });

        const data = await res.json();

        if (data.success) {
            showToast("Password changed successfully", "success");
            closePasswordModal();
        } else {
              document.getElementById("errOld").textContent = "Incorrect old password";
            document.getElementById("errOld").style.display = "block";
        }

    } catch {
        showToast("Something went wrong", "fail");
    }
});
// Clear errors on typing
document.getElementById("oldPassword").addEventListener("input", () => {
    document.getElementById("errOld").style.display = "none";
});
document.getElementById("newPassword").addEventListener("input", () => {
    document.getElementById("errNew").style.display = "none";
});
document.getElementById("confirmPassword").addEventListener("input", () => {
    document.getElementById("errConfirm").style.display = "none";
});

function togglePass(inputId, btn) {
    const input = document.getElementById(inputId);
    if (input.type === "password") {
        input.type = "text";
        btn.innerHTML = '<i class="fa fa-eye-slash"></i>';
        btn.style.color = "var(--gold)";
    } else {
        input.type = "password";
        btn.innerHTML = '<i class="fa fa-eye"></i>';
        btn.style.color = "#555";
    }
}
function validatePassword(password) {
    const hasUpper = /[A-Z]/.test(password);
    const hasLower = /[a-z]/.test(password);
    const hasNumber = /[0-9]/.test(password);
    const minLength = password.length >= 8;

    return hasUpper && hasLower && hasNumber && minLength;
}

</script>

