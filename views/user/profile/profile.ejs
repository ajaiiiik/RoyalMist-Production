top: 20px;
left: 50%;
transform: translateX(-50%);
background:#000;
border:2px solid #c4a14d;
color:#c4a14d;
padding:14px 28px;
font-family:'Playfair Display',serif;
font-size:14px;
font-weight:600;
letter-spacing:2px;
z-index:9999;
border-radius:2px;
">
</div>
