<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">
<title>Profile</title>
<!-- Itha replace pannу -->
<link href="https://fonts.googleapis.com/css2?family=Playfair+Display:wght@400;600;700&family=Montserrat:wght@300;400;600&display=swap" rel="stylesheet">
<link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/css/bootstrap.min.css" rel="stylesheet">
<link href="https://cdnjs.cloudflare.com/ajax/libs/cropperjs/1.5.13/cropper.min.css" rel="stylesheet"/>
<link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css">
<style>
:root {
    --gold: #c4a14d;
    --bg: #000;
    --card: #0a0a0a;
}
* { box-sizing: border-box; margin: 0; padding: 0; }
body {
    background: var(--bg);
    color: #fff;
    font-family: 'Playfair Display', serif;
}

/* ── NAV ── */
.top-bar {
    border-bottom: 1px solid #222;
    padding: 16px 20px;
    display: flex;
    align-items: center;
    justify-content: space-between;
    flex-wrap: wrap;
    gap: 12px;
}
.profile-title {
    color: var(--gold);
    letter-spacing: 3px;
    font-size: 18px;
    font-weight: 700;
    text-decoration: none;
}
.menu {
    display: flex;
    gap: 20px;
    flex-wrap: wrap;
}
.menu a {
    color: #fff;
    text-decoration: none;
    font-size: 13px;
    letter-spacing: 2px;
    transition: 0.3s;
}
.menu a:hover { color: var(--gold); }
.nav-menu a.active,
.menu a.active {
    color: var(--gold);
}
.nav-actions { display: flex; gap: 10px; }
.btn-header {
    border: 1px solid var(--gold);
    color: #fff;
    background: #000;
    padding: 6px 16px;
    font-size: 11px;
    letter-spacing: 2px;
    font-family: 'Playfair Display', serif;
    cursor: pointer;
    transition: 0.3s;
    white-space: nowrap;
}
.btn-header:hover { background: var(--gold); color: #000; }
.btn-header-logout {
    border: 1px solid var(--gold);
    color: var(--gold);
    background: #000;
    padding: 6px 16px;
    font-size: 11px;
    letter-spacing: 2px;
    font-family: 'Playfair Display', serif;
    cursor: pointer;
    transition: 0.3s;
    white-space: nowrap;
}
.btn-header-logout:hover { background: var(--gold); color: #000; }

/* ── CONTAINER ── */
.main-container {
    max-width: 1100px;
    margin: 0 auto;
    padding: 0 20px;
}

/* ── SECTION TITLE ── */
.section-title {
    margin: 36px 0 18px;
    padding-left: 15px;
    position: relative;
    font-size: 18px;
}
.section-title::before {
    content: "";
    position: absolute;
    left: 0; top: 6px;
    width: 3px; height: 20px;
    background: var(--gold);
}

/* ── CARD ── */
.card-box {
    border: 1px solid #1a1a1a;
    padding: 28px;
    background: var(--card);
    overflow: visible;
}

/* ── PROFILE IMAGE ── */
.profile-img {
    width: 80px;
    height: 80px;
    border-radius: 50%;
    background: #111;
    margin: 0 auto 24px;
    display: flex;
    align-items: center;
    justify-content: center;
    position: relative;
    cursor: pointer;
    font-size: 28px;
}
.profile-img .plus {
    position: absolute;
    bottom: 0; right: 0;
    background: var(--gold);
    color: #000;
    border-radius: 50%;
    font-size: 12px;
    padding: 5px;
    line-height: 1;
}
.profile-img:hover .plus { transform: scale(1.2); transition: 0.2s; }

/* ── FIELD ── */
.field { margin-top: 18px; }
.field label {
    font-size: 10px;
    color: var(--gold);
    letter-spacing: 2px;
    display: block;
    margin-bottom: 4px;
}
.field p {
    border-bottom: 1px solid #222;
    padding-bottom: 6px;
    font-size: 14px;
    word-break: break-all;
}

/* ── BUTTONS ── */
.btn-gold {
    border: 1px solid var(--gold);
    color: var(--gold);
    background: #000;
    padding: 8px 18px;
    font-size: 11px;
    letter-spacing: 2px;
    font-family: 'Playfair Display', serif;
    cursor: pointer;
    transition: 0.3s;
    white-space: nowrap;
}
.btn-gold:hover { background: var(--gold); color: #000; }

/* ── ADDRESS ── */
.address-wrapper {
    display: flex;
    flex-wrap: wrap;
    gap: 20px;
    margin-bottom: 50px;
}
.address-col {
    flex: 0 1 340px;
    display: flex;
    min-width: 0;
}
.address-box {
    border: 1px solid #1a1a1a;
    padding: 22px;
    background: var(--card);
    width: 100%;
}
.address-box h5 { font-size: 15px; margin-bottom: 8px; }
.address-box p { font-size: 13px; line-height: 1.7; color: #ccc; }
.add-box {
    border: 1px dashed #333;
    width: 100%;
    min-height: 180px;
    display: flex;
    align-items: center;
    justify-content: center;
    flex-direction: column;
    cursor: pointer;
    transition: 0.3s;
}
.add-box:hover { border-color: var(--gold); }
.add-box span { color: var(--gold); font-size: 22px; }
.add-box p { font-size: 12px; letter-spacing: 2px; color: #aaa; margin-top: 8px; }

/* ── SOURCE PICKER ── */
.source-modal-overlay {
    display: none;
    position: fixed;
    inset: 0;
    background: rgba(0,0,0,0.85);
    z-index: 1000;
    align-items: flex-end;
    justify-content: center;
}
.source-modal-overlay.active { display: flex; }
.source-sheet {
    background: #111;
    border: 1px solid #2a2a2a;
    border-bottom: none;
    width: 100%;
    max-width: 480px;
    padding: 30px 24px 40px;
    border-radius: 16px 16px 0 0;
    animation: slideUp 0.3s ease;
}
@keyframes slideUp {
    from { transform: translateY(100%); }
    to   { transform: translateY(0); }
}
.source-sheet h6 {
    color: #555;
    font-size: 11px;
    letter-spacing: 3px;
    text-align: center;
    margin-bottom: 24px;
}
.source-btn {
    width: 100%;
    padding: 14px;
    margin-bottom: 12px;
    background: #1a1a1a;
    border: 1px solid #2a2a2a;
    color: #fff;
    font-family: 'Playfair Display', serif;
    font-size: 13px;
    letter-spacing: 2px;
    cursor: pointer;
    transition: 0.2s;
}
.source-btn:hover { background: var(--gold); color: #000; border-color: var(--gold); }
.source-cancel {
    width: 100%;
    padding: 12px;
    background: transparent;
    border: 1px solid #333;
    color: #555;
    font-family: 'Playfair Display', serif;
    font-size: 12px;
    letter-spacing: 2px;
    cursor: pointer;
    margin-top: 4px;
    transition: 0.2s;
}
.source-cancel:hover { color: #fff; border-color: #555; }

/* ── CROP MODAL ── */
.crop-modal-overlay {
    display: none;
    position: fixed;
    inset: 0;
    background: rgba(0,0,0,0.95);
    z-index: 1100;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    padding: 20px;
}
.crop-modal-overlay.active { display: flex; }
.crop-container {
    width: 100%;
    max-width: 400px;
    background: #0d0d0d;
    border: 1px solid #2a2a2a;
    padding: 24px;
}
.crop-header {
    display: flex;
    justify-content: space-between;
    align-items: center;
    margin-bottom: 20px;
}
.crop-header span { color: var(--gold); font-size: 11px; letter-spacing: 3px; }
.crop-header button {
    background: none;
    border: none;
    color: #555;
    font-size: 20px;
    cursor: pointer;
    line-height: 1;
}
.crop-header button:hover { color: #fff; }
.crop-img-wrap { width: 100%; height: 260px; overflow: hidden; background: #000; }
.crop-img-wrap img { max-width: 100%; display: block; }
.crop-actions { display: flex; gap: 12px; margin-top: 20px; }
.crop-save {
    flex: 1;
    padding: 12px;
    background: var(--gold);
    color: #000;
    border: none;
    font-family: 'Playfair Display', serif;
    font-size: 12px;
    letter-spacing: 2px;
    cursor: pointer;
    transition: 0.2s;
}
.crop-save:hover { background: #d4b05d; }
.crop-cancel {
    padding: 12px 20px;
    background: transparent;
    border: 1px solid #333;
    color: #555;
    font-family: 'Playfair Display', serif;
    font-size: 12px;
    letter-spacing: 2px;
    cursor: pointer;
    transition: 0.2s;
}
.crop-cancel:hover { color: #fff; border-color: #555; }
.crop-saving {
    display: none;
    text-align: center;
    color: var(--gold);
    font-size: 11px;
    letter-spacing: 2px;
    margin-top: 12px;
}


/* ── EDIT ADDRESS MODAL ── */
.edit-modal-overlay {
    display: none;
    position: fixed;
    inset: 0;
    background: rgba(0,0,0,0.9);
    z-index: 1200;
    align-items: center;
    justify-content: center;
    padding: 20px;
}
.edit-modal-overlay.active { display: flex; }
.edit-modal {
    background: #0a0a0a;
    border: 1px solid #2a2a2a;
    padding: 32px;
    width: 100%;
    max-width: 600px;
    max-height: 90vh;
    overflow-y: auto;
    animation: fadeInUp 0.3s ease;
}
@keyframes fadeInUp {
    from { transform: translateY(30px); opacity: 0; }
    to   { transform: translateY(0);    opacity: 1; }
}
.edit-modal-header {
    display: flex;
    justify-content: space-between;
    align-items: center;
    margin-bottom: 24px;
    padding-bottom: 16px;
    border-bottom: 1px solid #1a1a1a;
}
.edit-modal-header span {
    color: var(--gold);
    font-size: 12px;
    letter-spacing: 3px;
}
.edit-modal-header button {
    background: none;
    border: none;
    color: #555;
    font-size: 20px;
    cursor: pointer;
    line-height: 1;
    transition: 0.2s;
}
.edit-modal-header button:hover { color: #fff; }
.edit-form { display: flex; flex-direction: column; gap: 20px; }
.edit-row { display: flex; gap: 20px; }
.edit-row .edit-field { flex: 1; min-width: 0; }
.edit-field label {
    font-size: 10px;
    color: var(--gold);
    letter-spacing: 2px;
    display: block;
    margin-bottom: 6px;
    text-transform: uppercase;
}
.edit-field input,
.edit-field select {
    width: 100%;
    padding: 11px 13px;
    background: #000;
    border: 1px solid #333;
    color: #fff;
    font-family: 'Playfair Display', serif;
    font-size: 13px;
    outline: none;
    transition: border-color 0.2s;
    appearance: none;
    -webkit-appearance: none;
}
.edit-field input:focus,
.edit-field select:focus { border-color: var(--gold); }
.edit-field input::placeholder { color: #444; }
.edit-select-wrap { position: relative; }
.edit-select-wrap::after {
    content: '›';
    position: absolute;
    right: 12px;
    top: 50%;
    transform: translateY(-50%) rotate(90deg);
    color: var(--gold);
    font-size: 16px;
    pointer-events: none;
}
.edit-field select option { background: #111; color: #fff; }
.edit-error { 
    color: red; 
    font-size: 12px; 
     margin-top: 4px;  
    margin-bottom: 10px;
    display: none; 
    font-family: 'Montserrat', sans-serif; 
}
.edit-actions { display: flex; gap: 12px; margin-top: 8px; }
.edit-save {
    flex: 1;
    padding: 13px;
    background: var(--gold);
    color: #000;
    border: none;
    font-family: 'Playfair Display', serif;
    font-size: 11px;
    letter-spacing: 3px;
    font-weight: 600;
    cursor: pointer;
    transition: 0.2s;
}
.edit-save:hover { background: #d4b05d; }
.edit-save:disabled { opacity: 0.6; cursor: not-allowed; }
.edit-cancel-btn {
    padding: 13px 20px;
    background: transparent;
    border: 1px solid #333;
    color: #555;
    font-family: 'Playfair Display', serif;
    font-size: 11px;
    letter-spacing: 2px;
    cursor: pointer;
    transition: 0.2s;
}
.edit-cancel-btn:hover { color: #fff; border-color: #555; }
@media (max-width: 480px) {
    .edit-modal { padding: 20px 16px; }
    .edit-row { flex-direction: column; gap: 16px; }
}

/* ── CONFIRM MODAL ── */
.confirm-overlay {
    display: none;
    position: fixed;
    inset: 0;
    background: rgba(0,0,0,0.88);
    z-index: 1300;
    align-items: center;
    justify-content: center;
    padding: 20px;
}
.confirm-overlay.active { display: flex; }
.confirm-box {
    background: #0a0a0a;
    border: 1px solid #2a2a2a;
    padding: 32px 28px;
    width: 100%;
    max-width: 360px;
    text-align: center;
}
.confirm-box p {
    font-size: 14px;
    color: #ccc;
    letter-spacing: 1px;
    margin-bottom: 24px;
    line-height: 1.7;
     font-family: 'Playfair Display', serif;
}
.confirm-actions { display: flex; gap: 12px; justify-content: center; }
.confirm-yes {
    flex: 1;
    padding: 12px;
    background: #c0392b;
    color: #fff;
    border: none;
    font-family: 'Playfair Display', serif;
    font-size: 11px;
    letter-spacing: 2px;
    cursor: pointer;
    transition: 0.2s;
}
.confirm-yes:hover { background: #e74c3c; }
.confirm-no {
    flex: 1;
    padding: 12px;
    background: transparent;
    border: 1px solid #333;
    color: #555;
    font-family: 'Playfair Display', serif;
    font-size: 11px;
    letter-spacing: 2px;
    cursor: pointer;
    transition: 0.2s;
}
.confirm-no:hover { color: #fff; border-color: #555; }


/* ── MOBILE ── */
@media (max-width: 768px) {
    .top-bar { flex-direction: column; align-items: center; text-align: center; padding: 14px 16px; gap: 10px; }
    .menu { justify-content: center; gap: 14px; }
    .menu a { font-size: 12px; }
    .nav-actions { justify-content: center; }
    .main-container { padding: 0 14px; }
    .card-box { padding: 20px 16px; }
    .section-title { font-size: 16px; margin: 28px 0 14px; }
    .address-col { flex: 1 1 100%; }
    .add-box { min-height: 140px; }
    .btn-gold { padding: 8px 14px; font-size: 10px; }
}
@media (max-width: 480px) {
    .profile-title { font-size: 15px; letter-spacing: 2px; }
    .btn-header, .btn-header-logout { padding: 6px 12px; font-size: 10px; }
    .menu a { font-size: 11px; letter-spacing: 1px; }
    .card-box { padding: 16px 12px; }
}
</style>
</head>
<body>

<!-- NAV -->
<div class="top-bar">
    <a class="profile-title" href="#">PROFILE</a>
    <div class="menu">
        <a href="/orders">Order History</a>
        <a href="/wallet">Wallet</a>
        <a href="/addAddress">Add Address</a>
    </div>
    <div class="nav-actions">
        <button class="btn-header" onclick="window.location.href='/home'">HOME</button>
        <button class="btn-header-logout" id="logoutBtn">LOGOUT</button>
    </div>
</div>

<div class="main-container">

    <!-- PROFILE SECTION -->
    <h3 class="section-title">User Profile</h3>

    <div class="card-box">

        <div class="profile-img" id="profileWrapper">
            <% if (user.profileImage) { %>
                <img src="<%= user.profileImage %>?t=<%= Date.now() %>"
                     style="width:80px;height:80px;border-radius:50%;object-fit:cover;">
            <% } else { %>
                👤
            <% } %>
            <div class="plus" id="uploadBtn">+</div>
        </div>

        <input type="file" id="profileInputGallery" style="display:none;" accept="image/*">
        <input type="file" id="profileInputCamera"  style="display:none;" accept="image/*" capture="user">

        <!-- SOURCE PICKER -->
        <div class="source-modal-overlay" id="sourceModal">
            <div class="source-sheet">
                <h6>CHANGE PHOTO</h6>
                <button class="source-btn" id="chooseGallery">📷 &nbsp; CHOOSE FROM GALLERY</button>
                <button class="source-btn" id="removePhoto" style="color:#ff4444;border-color:#ff4444;">🗑 &nbsp; REMOVE PHOTO</button>
                <button class="source-cancel" id="sourceCancel">CANCEL</button>
            </div>
        </div>

        <!-- CROP MODAL -->
        <div class="crop-modal-overlay" id="cropModal">
            <div class="crop-container">
                <div class="crop-header">
                    <span>CROP PHOTO</span>
                    <button id="cropClose">✕</button>
                </div>
                <div class="crop-img-wrap">
                    <img id="cropImage" src="">
                </div>
                <div class="crop-actions">
                    <button class="crop-cancel" id="cropCancelBtn">CANCEL</button>
                    <button class="crop-save" id="cropSaveBtn">SAVE PHOTO</button>
                </div>
                <div class="crop-saving" id="cropSaving">UPLOADING...</div>
            </div>
        </div>

        <div class="row">
            <div class="col-md-6 field">
                <label>FIRST NAME</label>
                <p><%= user.firstName %></p>
            </div>
            <div class="col-md-6 field">
                <label>LAST NAME</label>
                <p><%= user.lastName %></p>
            </div>
            <div class="col-md-6 field">
                <label>EMAIL</label>
                <p><%= user.email %></p>
            </div>
            <div class="col-md-6 field">
                <label>PHONE NUMBER</label>
                <p><%= user.phone %></p>
            </div>
            <div class="col-12 field">
                <label>REFERRAL CODE</label>
                <p><%= user.myReferralCode %></p>
            </div>
        </div>

        <div class="mt-4 d-flex gap-2 flex-wrap">
            <button class="btn-gold" onclick="window.location.href='/editProfile'">EDIT PROFILE</button>
            <button class="btn-gold"  id="changePasswordBtn">CHANGE PASSWORD</button>
        </div>

    </div>

    <!-- ADDRESS SECTION -->
    <h3 class="section-title">Saved Addresses</h3>

    <div class="address-wrapper">
        <% if (user.addresses && user.addresses.length > 0) { %>
            <% user.addresses.forEach(address => { %>
                <div class="address-col">
                    <div class="address-box">
                        <h5><%= address.fullName %>
    <span style="
  font-size:10px;
  color:<%= address.addressType === 'home' ? '#4caf50' : '#c4a14d' %>;
  border:1px solid <%= address.addressType === 'home' ? '#4caf50' : '#c4a14d' %>;
  padding:2px 6px;
  margin-left:6px;
  letter-spacing:1px;
">
  <%= address.addressType.toUpperCase() %>
</span></h5>
                        <p>
                            <%= address.addressLine1 %><br>
                            <% if (address.addressLine2) { %>
                                <%= address.addressLine2 %><br>
                            <% } %>
                            <%= address.city %> - <%= address.zipCode %><br>
                            <%= address.state %>, <%= address.country %>
                        </p>
                        <div class="d-flex gap-2 mt-3 flex-wrap">
                          <button class="btn-gold" onclick="openEditModal('<%= address._id %>')">EDIT</button>
                            <button class="btn-gold" onclick="confirmDelete('<%= address._id %>')">DELETE</button>
                        </div>
                    </div>
                </div>
            <% }) %>
        <% } %>
    </div>
    <!-- EDIT ADDRESS MODAL -->
<div class="edit-modal-overlay" id="editModal">
    <div class="edit-modal">
        <div class="edit-modal-header">
            <span>EDIT ADDRESS</span>
            <button id="editModalClose">✕</button>
        </div>
        <div class="edit-form">
            <div class="edit-row">
                <div class="edit-field">
                    <label>Full Name</label>
                    <input id="e_fullName" type="text" placeholder="Enter name">
                    <div class="edit-error" id="e_errName">Full name is required</div>
                </div>
                <div class="edit-field">
                    <label>Address Type</label>
                    <div class="edit-select-wrap">
                        <select id="e_addressType">
                            <option value="home">Home</option>
                            <option value="work">Work</option>
                            <option value="other">Other</option>
                        </select>
                    </div>
                </div>
            </div>
            <div class="edit-field">
                <label>Address Line 1</label>
                <input id="e_addr1" type="text" placeholder="Street address">
                <div class="edit-error" id="e_errAddr1">Address line 1 is required</div>
            </div>
            <div class="edit-field">
                <label>Address Line 2 <span style="color:#444;font-size:10px;">(Optional)</span></label>
                <input id="e_addr2" type="text" placeholder="Apartment, suite, etc.">
            </div>
            <div class="edit-row">
                <div class="edit-field">
                    <label>City</label>
                    <input id="e_city" type="text" placeholder="City">
                    <div class="edit-error" id="e_errCity">City is required</div>
                </div>
                <div class="edit-field">
                    <label>State</label>
                    <input id="e_state" type="text" placeholder="State">
                    <div class="edit-error" id="e_errState">State is required</div>
                </div>
            </div>
            <div class="edit-row">
                <div class="edit-field">
                    <label>Country</label>
                    <div class="edit-select-wrap">
                        <select id="e_country">
                            <option value="IN">India</option>
                            <option value="US">United States</option>
                            <option value="GB">United Kingdom</option>
                            <option value="CA">Canada</option>
                            <option value="AU">Australia</option>
                            <option value="AE">UAE</option>
                            <option value="SG">Singapore</option>
                            <option value="DE">Germany</option>
                            <option value="FR">France</option>
                            <option value="JP">Japan</option>
                        </select>
                    </div>
                </div>
                <div class="edit-field">
                    <label>ZIP / PIN Code</label>
                    <input id="e_zip" type="text" placeholder="Zip code" maxlength="10">
                    <div class="edit-error" id="e_errZip">Valid ZIP/PIN required</div>
                </div>
            </div>
            <div class="edit-actions">
                <button class="edit-cancel-btn" id="editCancelBtn">CANCEL</button>
                <button class="edit-save" id="editSaveBtn">SAVE CHANGES</button>
            </div>
        </div>
    </div>
</div>

<div id="toast" style="
display:none;
