<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">
<title>ROYALMIST — Admin Dashboard</title>
<link href="https://fonts.googleapis.com/css2?family=Playfair+Display:wght@400;600;700&display=swap" rel="stylesheet">
<link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css">
<script src="https://cdn.jsdelivr.net/npm/chart.js"></script>
<style>
:root {
    --gold: #c4a14d;
    --gold-light: #d4b05d;
    --gold-dim: rgba(196,161,77,0.15);
    --bg: #000;
    --sidebar-bg: #050505;
    --card: #0a0a0a;
    --card-border: #1a1a1a;
    --text: #fff;
    --text-muted: #888;
    --text-dim: #555;
    --sidebar-w: 220px;
    --green: #4caf82;
    --red: #e05252;
    --blue: #5b8cff;
    --pink: #e07070;
}

* { box-sizing: border-box; margin: 0; padding: 0; }

body {
    background: var(--bg);
    color: var(--text);
    font-family: 'Playfair Display', serif;
    min-height: 100vh;
    display: flex;
}

/* ─── SIDEBAR ─── */
.sidebar {
    width: var(--sidebar-w);
    min-height: 100vh;
    background: var(--sidebar-bg);
    border-right: 1px solid #111;
    display: flex;
    flex-direction: column;
    position: fixed;
    top: 0; left: 0;
    z-index: 100;
    transition: transform 0.3s ease;
}

.sidebar-logo {
    display: flex;
    align-items: center;
    gap: 10px;
    padding: 22px 20px 26px;
    border-bottom: 1px solid #111;
}

.logo-icon {
    width: 30px;
    height: 30px;
    background: var(--gold);
    clip-path: polygon(0 0, 55% 0, 100% 45%, 100% 100%, 45% 100%, 0 55%);
}

.logo-text {
    font-family: 'Playfair Display', serif;
    font-size: 15px;
    font-weight: 700;
    letter-spacing: 3px;
    color: var(--gold);
}

.nav-menu {
    flex: 1;
    padding: 20px 0;
    overflow-y: auto;
}

.nav-item {
    display: flex;
    align-items: center;
    gap: 14px;
    padding: 13px 24px;
    color: #666;
    text-decoration: none;
    font-size: 13px;
    letter-spacing: 1px;
    transition: all 0.2s;
    border-left: 3px solid transparent;
    cursor: pointer;
}
.nav-item:hover { color: var(--gold); background: rgba(196,161,77,0.15); }
.nav-item.active {
    color: var(--gold);
    border-left-color: var(--gold);
    background: var(--gold-dim);
}
.nav-item i { width: 18px; text-align: center; font-size: 13px; }

/* ─── MAIN ─── */
.main {
    margin-left: var(--sidebar-w);
    flex: 1;
    min-height: 100vh;
    display: flex;
    flex-direction: column;
}

/* ─── TOP BAR ─── */
.topbar {
    display: flex;
    align-items: center;
    justify-content: space-between;
    padding: 18px 30px;
    border-bottom: 1px solid #111;
    position: sticky;
    top: 0;
    background: var(--bg);
    z-index: 50;
    flex-wrap: wrap;
    gap: 12px;
}

.topbar-title {
    font-family: 'Playfair Display', serif;
    font-size: 26px;
    font-weight: 700;
    letter-spacing: 1px;
}

.topbar-right {
    display: flex;
    align-items: center;
    gap: 16px;
}

.topbar-icon {
    width: 36px; height: 36px;
    border: 1px solid #222;
    border-radius: 50%;
    display: flex; align-items: center; justify-content: center;
    color: var(--text-muted);
    font-size: 13px;
    cursor: pointer;
    transition: 0.2s;
}
.topbar-icon:hover { border-color: var(--gold); color: var(--gold); }

.topbar-avatar {
    width: 36px; height: 36px;
    border-radius: 50%;
    background: var(--gold-dim);
    border: 1px solid var(--gold);
    display: flex; align-items: center; justify-content: center;
    font-family: 'Playfair Display', serif;
    font-size: 14px;
    color: var(--gold);
    cursor: pointer;
}

.hamburger {
    display: none;
    background: none;
    border: 1px solid #222;
    color: var(--text-muted);
    padding: 7px 10px;
    cursor: pointer;
    font-size: 16px;
    border-radius: 2px;
    transition: 0.2s;
    align-items: center;
    justify-content: center;
}
.hamburger:hover { border-color: var(--gold); color: var(--gold); }

/* ─── CONTENT ─── */
.content {
    padding: 30px;
    flex: 1;
}

/* ─── STAT CARDS ROW 1 ─── */
.stats-row {
    display: grid;
    grid-template-columns: repeat(4, 1fr);
    gap: 16px;
    margin-bottom: 16px;
}

.stat-card {
    background: var(--card);
    border: 1px solid var(--card-border);
    padding: 22px 20px 18px;
    position: relative;
    overflow: hidden;
    transition: border-color 0.2s;
}
.stat-card:hover { border-color: #2a2a2a; }

.stat-top {
    display: flex;
    justify-content: space-between;
    align-items: flex-start;
    margin-bottom: 14px;
}

.stat-icon {
    width: 38px; height: 38px;
    background: var(--gold-dim);
    display: flex; align-items: center; justify-content: center;
    font-size: 16px;
    color: var(--gold);
}

.stat-badge {
    font-size: 10px;
    letter-spacing: 1px;
    padding: 3px 7px;
    border-radius: 20px;
    font-weight: 500;
    font-family: 'Playfair Display', serif;
}
.badge-green { background: rgba(76,175,130,0.15); color: var(--green); }
.badge-red   { background: rgba(224,82,82,0.15);  color: var(--red);   }

.stat-label {
    font-size: 9px;
    letter-spacing: 2.5px;
    color: var(--text-muted);
    text-transform: uppercase;
    margin-bottom: 6px;
}

.stat-value {
    font-family: 'Playfair Display', serif;
    font-size: 28px;
    font-weight: 700;
    letter-spacing: -0.5px;
    line-height: 1;
}

/* ─── STAT CARDS ROW 2 (order status) ─── */
.status-row {
    display: grid;
    grid-template-columns: repeat(4, 1fr);
    gap: 16px;
    margin-bottom: 30px;
}

.status-card {
    background: var(--card);
    border: 1px solid var(--card-border);
    padding: 18px 20px;
    display: flex;
    align-items: center;
    gap: 12px;
    transition: border-color 0.2s;
}
.status-card:hover { border-color: #2a2a2a; }

.status-dot {
    width: 9px; height: 9px;
    border-radius: 50%;
    flex-shrink: 0;
}
.dot-green { background: var(--green); box-shadow: 0 0 8px rgba(76,175,130,0.5); }
.dot-yellow{ background: var(--gold);  box-shadow: 0 0 8px rgba(196,161,77,0.5); }
.dot-blue  { background: var(--blue);  box-shadow: 0 0 8px rgba(91,140,255,0.5); }
.dot-pink  { background: var(--pink);  box-shadow: 0 0 8px rgba(224,112,112,0.5); }

.status-info {}
.status-label {
    font-size: 9px;
    letter-spacing: 2px;
    color: var(--text-muted);
    text-transform: uppercase;
}
.status-value {
    font-family: 'Playfair Display', serif;
    font-size: 20px;
    font-weight: 700;
    margin-top: 2px;
}

/* ─── REVENUE SECTION ─── */
.revenue-section {
    background: var(--card);
    border: 1px solid var(--card-border);
    padding: 26px 24px;
    margin-bottom: 30px;
}

.revenue-header {
    display: flex;
    align-items: flex-start;
    justify-content: space-between;
    flex-wrap: wrap;
    gap: 16px;
    margin-bottom: 24px;
}

.revenue-title {}
.revenue-title h3 {
    font-family: 'Playfair Display', serif;
    font-size: 20px;
    font-weight: 700;
    margin-bottom: 4px;
}
.revenue-title p {
    font-size: 11px;
    color: var(--text-muted);
    letter-spacing: 1px;
}

.revenue-controls {
    display: flex;
    align-items: center;
    gap: 8px;
    flex-wrap: wrap;
}

.period-btns {
    display: flex;
    gap: 4px;
}

.period-btn {
    padding: 6px 14px;
    border: 1px solid #222;
    background: transparent;
    color: var(--text-muted);
    font-family: 'Playfair Display', serif;
    font-size: 10px;
    letter-spacing: 2px;
    cursor: pointer;
    transition: 0.2s;
}
.period-btn:hover { border-color: var(--gold); color: var(--gold); }
.period-btn.active { background: var(--gold); color: #000; border-color: var(--gold); font-weight: 600; }

.date-input-wrap {
    display: flex;
    align-items: center;
    gap: 6px;
}

.date-field {
    display: flex;
    align-items: center;
    gap: 6px;
    border: 1px solid #222;
    padding: 6px 10px;
    background: #000;
    cursor: pointer;
}
.date-field i { color: var(--gold); font-size: 11px; }
.date-field span { font-size: 10px; color: var(--text-muted); letter-spacing: 1px; }

.date-sep { font-size: 11px; color: var(--text-dim); }

.apply-btn {
    padding: 6px 18px;
    background: var(--gold);
    color: #000;
    border: none;
    font-family: 'Playfair Display', serif;
    font-size: 10px;
    letter-spacing: 2px;
    font-weight: 600;
    cursor: pointer;
    transition: 0.2s;
}
.apply-btn:hover { background: var(--gold-light); }

.chart-wrap {
    position: relative;
    height: 280px;
}

/* ─── BOTTOM GRID ─── */
.bottom-grid {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 20px;
    margin-bottom: 30px;
}

/* ─── TOP SELLING PRODUCTS ─── */
.products-section {
    background: var(--card);
    border: 1px solid var(--card-border);
    padding: 24px;
}

.section-header {
    display: flex;
    justify-content: space-between;
    align-items: center;
    margin-bottom: 22px;
}

.section-header h3 {
    font-family: 'Playfair Display', serif;
    font-size: 17px;
    font-weight: 700;
}

.view-all {
    font-size: 9px;
    letter-spacing: 2px;
    color: var(--gold);
    text-decoration: none;
    border: 1px solid var(--gold);
    padding: 5px 10px;
    transition: 0.2s;
    background: transparent;
    cursor: pointer;
    font-family: 'Playfair Display', serif;
    font-weight: 600;
}
.view-all:hover { background: var(--gold); color: #000; }

.product-item {
    display: flex;
    align-items: center;
    gap: 14px;
    padding: 14px 0;
    border-bottom: 1px solid #111;
}
.product-item:last-child { border-bottom: none; padding-bottom: 0; }

.product-img {
    width: 44px; height: 44px;
    background: #0f0f0f;
    border: 1px solid #1a1a1a;
    display: flex; align-items: center; justify-content: center;
    font-size: 20px;
    color: var(--gold);
    flex-shrink: 0;
    position: relative;
}

.product-rank {
    position: absolute;
    top: -6px; right: -6px;
    width: 16px; height: 16px;
    background: var(--gold);
    color: #000;
    font-size: 8px;
    font-weight: 700;
    border-radius: 50%;
    display: flex; align-items: center; justify-content: center;
    font-family: 'Playfair Display', serif;
}

.product-info { flex: 1; min-width: 0; }
.product-name {
    font-family: 'Playfair Display', serif;
    font-size: 13px;
    font-weight: 600;
    white-space: nowrap;
    overflow: hidden;
    text-overflow: ellipsis;
}
.product-meta {
    font-size: 9px;
    color: var(--text-muted);
    letter-spacing: 1.5px;
    margin-top: 2px;
    text-transform: uppercase;
}

.product-price {
    font-family: 'Playfair Display', serif;
    font-size: 14px;
    color: var(--gold);
    font-weight: 600;
    flex-shrink: 0;
}

/* ─── TOP CATEGORIES ─── */
.categories-section {
    background: var(--card);
    border: 1px solid var(--card-border);
    padding: 24px;
}

.analytics-link {
    font-size: 9px;
    letter-spacing: 2px;
    color: var(--gold);
    cursor: pointer;
    font-weight: 600;
    font-family: 'Playfair Display', serif;
}

.category-item {
    margin-bottom: 20px;
}
.category-item:last-child { margin-bottom: 0; }

.cat-header {
    display: flex;
    justify-content: space-between;
    align-items: baseline;
    margin-bottom: 7px;
}

.cat-name {
    font-size: 11px;
    letter-spacing: 1.5px;
    color: var(--text);
    text-transform: uppercase;
    font-weight: 500;
}

.cat-pct {
    font-size: 11px;
    color: var(--text-muted);
    letter-spacing: 1px;
}

.cat-bar-track {
    width: 100%;
    height: 3px;
    background: #1a1a1a;
    border-radius: 2px;
    overflow: hidden;
}

.cat-bar-fill {
    height: 100%;
    background: var(--gold);
    border-radius: 2px;
    transition: width 1.2s ease;
}

/* ─── SIDEBAR OVERLAY (mobile) ─── */
.sidebar-overlay {
    display: none;
    position: fixed;
    inset: 0;
    background: rgba(0,0,0,0.7);
    z-index: 99;
}
.sidebar-overlay.active { display: block; }

/* ─── RESPONSIVE ─── */
@media (max-width: 1100px) {
    .stats-row, .status-row { grid-template-columns: repeat(2, 1fr); }
}

@media (max-width: 900px) {
    .bottom-grid { grid-template-columns: 1fr; }
    .revenue-controls { flex-direction: column; align-items: flex-start; gap: 10px; }
}

@media (max-width: 768px) {
    :root { --sidebar-w: 220px; }

    .sidebar {
        transform: translateX(-100%);
    }
    .sidebar.open {
        transform: translateX(0);
    }

    .main { margin-left: 0; }
    .hamburger { display: flex; align-items: center; justify-content: center; }
    .content { padding: 20px 16px; }
    .topbar { padding: 14px 16px; }
    .topbar-title { font-size: 22px; }

    .stats-row { grid-template-columns: repeat(2, 1fr); gap: 12px; }
    .status-row { grid-template-columns: repeat(2, 1fr); gap: 12px; }
    .stat-value { font-size: 22px; }

    .date-input-wrap { flex-wrap: wrap; }
    .period-btns { flex-wrap: wrap; }
}

@media (max-width: 480px) {
    .stats-row { grid-template-columns: 1fr; }
    .status-row { grid-template-columns: 1fr 1fr; }
    .revenue-section, .products-section, .categories-section { padding: 18px 14px; }
    .stat-card { padding: 16px 14px; }
}
</style>
</head>
<body>

<!-- SIDEBAR OVERLAY -->
<div class="sidebar-overlay" id="sidebarOverlay"></div>

<!-- SIDEBAR -->
<aside class="sidebar" id="sidebar">
   <div class="sidebar-logo">
    <span class="logo-text"><i class="fas fa-gem me-2" style="color:var(--gold)"></i>ROYALMIST</span>
  </div>
    <nav class="nav-menu">
    <a class="nav-item active" href="/admin/dashboard">
        <i class="fas fa-th-large"></i>
        <span>Dashboard</span>
    </a>
    <a class="nav-item" href="/admin/products">
        <i class="fas fa-box"></i>
        <span>Products</span>
    </a>
    <a class="nav-item" href="/admin/categories">
        <i class="fas fa-tag"></i>
        <span>Categories</span>
    </a>
    <a class="nav-item" href="/admin/coupons">
        <i class="fas fa-ticket-alt"></i>
        <span>Coupons</span>
    </a>
    <a class="nav-item" href="/admin/customers">
        <i class="fas fa-users"></i>
        <span>Customers</span>
    </a>
    <a class="nav-item" href="/admin/orders">
        <i class="fas fa-shopping-bag"></i>
        <span>Orders</span>
    </a>
    <a class="nav-item" href="/admin/inventory">
        <i class="fas fa-warehouse"></i>
        <span>Inventory</span>
    </a>
    <a class="nav-item" href="/admin/product-offer">
        <i class="fas fa-percent"></i>
        <span>Product Offer</span>
    </a>
    <a class="nav-item" href="/admin/category-offer">
        <i class="fas fa-layer-group"></i>
        <span>Category Offer</span>
    </a>
    <a class="nav-item" href="/admin/sales-report">
        <i class="fas fa-chart-bar"></i>
        <span>Sales Report</span>
    </a>
    <a class="nav-item" href="/admin/logout">
        <i class="fas fa-right-from-bracket"></i>
        <span>Logout</span>
    </a>
</nav>
</aside>

<!-- MAIN -->
<div class="main">

    <!-- TOP BAR -->
    <div class="topbar">
        <div style="display:flex;align-items:center;gap:14px;">
            <button class="hamburger" id="hamburger">
                <i class="fas fa-bars"></i>
            </button>
            <h1 class="topbar-title">Dashboard</h1>
        </div>
        <div class="topbar-right">
            <div class="topbar-icon"><i class="fas fa-bell"></i></div>
        </div>
    </div>

    <!-- CONTENT -->
    <div class="content">

        <!-- STAT CARDS ROW 1 -->
        <div class="stats-row">
            <div class="stat-card">
                <div class="stat-top">
                    <div class="stat-icon"><i class="fas fa-users"></i></div>
                    <span class="stat-badge badge-green">↑ 12%</span>
                </div>
               <div class="stat-label">Total Customers</div>
<div class="stat-value"><%= totalCustomers.toLocaleString() %></div>
            </div>
            <div class="stat-card">
                <div class="stat-top">
                    <div class="stat-icon"><i class="fas fa-calendar-alt"></i></div>
                    <span class="stat-badge badge-green">↑ 54%</span>
                </div>
                <div class="stat-label">Monthly Total</div>
                <div class="stat-value">₹2000</div>
            </div>
            <div class="stat-card">
                <div class="stat-top">
                    <div class="stat-icon"><i class="fas fa-shopping-cart"></i></div>
                    <span class="stat-badge badge-red">↓ 2.1%</span>
                </div>
                <div class="stat-label">Total Orders</div>
              <div class="stat-value"><%= totalOrders.toLocaleString() %></div>
            </div>
            <div class="stat-card">
                <div class="stat-top">
                    <div class="stat-icon"><i class="fas fa-coins"></i></div>
                    <span class="stat-badge badge-green">↑ 18%</span>
                </div>
                <div class="stat-label">Total Revenue</div>
              <div class="stat-value">₹<%= totalRevenue.toLocaleString('en-IN') %></div>
            </div>
        </div>

        <!-- STATUS CARDS ROW 2 -->
        <div class="status-row">
            <div class="status-card">
                <div class="status-dot dot-green"></div>
                <div class="status-info">
                    <div class="status-label">Delivered</div>
                    <div class="status-value"><%= delivered.toLocaleString() %></div>
                </div>
            </div>
            <div class="status-card">
                <div class="status-dot dot-yellow"></div>
                <div class="status-info">
                    <div class="status-label">Pending</div>
                 <div class="status-value"><%= pending.toLocaleString() %></div>
                </div>
            </div>
            <div class="status-card">
                <div class="status-dot dot-blue"></div>
                <div class="status-info">
                    <div class="status-label">Shipping</div>
                  <div class="status-value"><%= shipped.toLocaleString() %></div>
                </div>
            </div>
            <div class="status-card">
                <div class="status-dot dot-pink"></div>
                <div class="status-info">
                    <div class="status-label">Cancelled</div>
                 <div class="status-value"><%= cancelled.toLocaleString() %></div>
                </div>
            </div>
        </div>

        <!-- REVENUE CHART -->
        <div class="revenue-section">
            <div class="revenue-header">
                <div class="revenue-title">
                    <h3>Revenue Performance</h3>
                    <p>Detailed sales analytics across periods</p>
                </div>
                <div class="revenue-controls">
                    <div class="period-btns">
                        <button class="period-btn active" onclick="switchPeriod(this,'week')">WEEK</button>
                        <button class="period-btn" onclick="switchPeriod(this,'month')">MONTH</button>
                        <button class="period-btn" onclick="switchPeriod(this,'year')">YEAR</button>
                    </div>
                    <div class="date-input-wrap">
                        <div class="date-field">
                            <i class="fas fa-calendar"></i>
                            <span>Oct 01, 2023</span>
                        </div>
                        <span class="date-sep">to</span>
                        <div class="date-field">
                            <i class="fas fa-calendar"></i>
                            <span>Oct 31, 2023</span>
                        </div>
                        <button class="apply-btn">APPLY</button>
                    </div>
                </div>
            </div>
            <div class="chart-wrap">
                <canvas id="revenueChart"></canvas>
            </div>
        </div>

        <!-- BOTTOM GRID -->
        <div class="bottom-grid">

            <!-- TOP SELLING PRODUCTS -->
            <div class="products-section">
                <div class="section-header">
                    <h3>Top Selling Products</h3>
                    <a class="view-all" href="#">VIEW ALL</a>
                </div>

                <div class="product-item">
                    <div class="product-img">
                        🧴
                        <span class="product-rank">1</span>
                    </div>
                    <div class="product-info">
                        <div class="product-name">Midnight Oud Eau de Parfum</div>
                        <div class="product-meta">150ML • Premium Line</div>
                    </div>
                    <div class="product-price">$295</div>
                </div>

                <div class="product-item">
                    <div class="product-img">
                        🧴
                        <span class="product-rank">2</span>
                    </div>
                    <div class="product-info">
                        <div class="product-name">Velvet Rose Extract</div>
                        <div class="product-meta">100ML • Signature Line</div>
                    </div>
                    <div class="product-price">$410</div>
                </div>

                <div class="product-item">
                    <div class="product-img">
                        🧴
                        <span class="product-rank">3</span>
                    </div>
                    <div class="product-info">
                        <div class="product-name">Amber Royale</div>
                        <div class="product-meta">50ML • Exclusive Line</div>
                    </div>
                    <div class="product-price">$185</div>
                </div>

            </div>

            <!-- TOP SELLING CATEGORIES -->
            <div class="categories-section">
                <div class="section-header">
                    <h3>Top Selling Categories</h3>
