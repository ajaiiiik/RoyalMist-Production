<script>
/* ─── HAMBURGER ─── */
const hamburger = document.getElementById('hamburger');
const sidebar   = document.getElementById('sidebar');
const overlay   = document.getElementById('sidebarOverlay');

hamburger.addEventListener('click', () => {
    sidebar.classList.toggle('open');
    overlay.classList.toggle('active');
});
overlay.addEventListener('click', () => {
    sidebar.classList.remove('open');
    overlay.classList.remove('active');
});

/* ─── NAV ACTIVE ─── */
document.querySelectorAll('.nav-item').forEach(item => {
    item.addEventListener('click', function(e) {
        document.querySelectorAll('.nav-item').forEach(i => i.classList.remove('active'));
        this.classList.add('active');
        if (window.innerWidth < 768) {
            sidebar.classList.remove('open');
            overlay.classList.remove('active');
        }
    });
});

/* ─── CHART DATA ─── */
const chartData = <%- chartDataJson %>;


const chartDocument = {
    week :{
        months : ["SEP"],
        data :[2000,3000,4000,5000]
    }
}

/* ─── CHART INIT ─── */
const ctx = document.getElementById('revenueChart').getContext('2d');

const gradient = ctx.createLinearGradient(0, 0, 0, 280);
gradient.addColorStop(0, 'rgba(196,161,77,0.4)');
gradient.addColorStop(1, 'rgba(196,161,77,0.02)');

let revenueChart = new Chart(ctx, {
    type: 'bar',
    data: {
        labels: chartData.week.labels,
        datasets: [{
            data: chartData.week.data,
            backgroundColor: chartData.week.data.map((v, i) =>
                i === 4 ? 'rgba(196,161,77,0.85)' : 'rgba(196,161,77,0.22)'
            ),
            borderColor: chartData.week.data.map((v, i) =>
                i === 4 ? 'rgba(196,161,77,1)' : 'rgba(196,161,77,0.4)'
            ),
            borderWidth: 1,
            borderRadius: 2,
            borderSkipped: false,
        }]
    },
    options: {
        responsive: true,
        maintainAspectRatio: false,
        plugins: {
            legend: { display: false },
            tooltip: {
                backgroundColor: '#0a0a0a',
                borderColor: '#c4a14d',
                borderWidth: 1,
                titleColor: '#c4a14d',
                bodyColor: '#fff',
                titleFont: { family: 'Playfair Display', size: 13 },
                bodyFont: { family: 'Playfair Display', size: 11 },
                padding: 12,
                callbacks: {
                    label: ctx => ' ₹' + ctx.parsed.y.toLocaleString()
                }
            }
        },
        scales: {
            x: {
                grid: { color: 'rgba(255,255,255,0.04)', drawBorder: false },
                ticks: { color: '#666', font: { family: 'Playfair Display', size: 10 }, letterSpacing: 2 },
                border: { color: '#1a1a1a' }
            },
            y: {
                grid: { color: 'rgba(255,255,255,0.04)', drawBorder: false },
                ticks: {
                    color: '#555',
                    font: { family: 'Playfair Display', size: 10 },
                    callback: v => '₹' + (v >= 1000 ? (v/1000).toFixed(0)+'k' : v)
                },
                border: { color: 'transparent' }
            }
        }
    }
});

/* ─── PERIOD SWITCH ─── */
function switchPeriod(btn, period) {
    document.querySelectorAll('.period-btn').forEach(b => b.classList.remove('active'));
    btn.classList.add('active');

    const d = chartData[period];
    const maxIdx = d.data.indexOf(Math.max(...d.data));

    revenueChart.data.labels = d.labels;
    revenueChart.data.datasets[0].data = d.data;
    revenueChart.data.datasets[0].backgroundColor = d.data.map((v, i) =>
        i === maxIdx ? 'rgba(196,161,77,0.85)' : 'rgba(196,161,77,0.22)'
    );
    revenueChart.data.datasets[0].borderColor = d.data.map((v, i) =>
        i === maxIdx ? 'rgba(196,161,77,1)' : 'rgba(196,161,77,0.4)'
    );
    revenueChart.update('active');
}
</script>
</body>
</html>